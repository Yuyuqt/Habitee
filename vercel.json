{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "dotnet publish Habitee/Habitee.csproj -c Release",
  "outputDirectory": "Habitee/bin/Release/net8.0/publish/wwwroot",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "trailingSlash": false
}
