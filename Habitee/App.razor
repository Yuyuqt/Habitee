@using Habitee.Layout
@inject ThemeService ThemeService
@inject DatabaseService DbService
@inject AuthService AuthService
@inject NavigationManager NavManager
@inject NotificationService NotificationService
@implements IDisposable

@if (!isReady)
{
    <BackgroundLayer />
    <div class="app-loading-shell">
        <div class="app-loading-card glass-panel">
            <div class="app-loader-mark" aria-hidden="true">
                <div class="loader-orbit orbit-one"></div>
                <div class="loader-orbit orbit-two"></div>
                <div class="loader-core">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="8"></circle>
                        <path d="M12 7v5l3 3"></path>
                    </svg>
                </div>
            </div>
            <h1>Habitee</h1>
            <p>Setting up your local-first habit space...</p>
            <div class="app-loader-dots" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
}
else
{
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            @if (ShouldRedirectToLogin())
            {
                <Habitee.Components.RedirectTo Url="@GetLoginUrl()" />
            }
            else if (ShouldRedirectToApp())
            {
                <Habitee.Components.RedirectTo Url="/app" />
            }
            else
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
            }
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(PublicLayout)">
                <div class="missing-route glass-panel">
                    <h1>Nothing here</h1>
                    <p>The page you were looking for drifted off the habit trail.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
}

<style>
    .app-loading-shell {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        position: relative;
        z-index: 1;
    }

    .app-loading-card,
    .missing-route {
        max-width: 420px;
        padding: 2rem;
        text-align: center;
    }

    .app-loading-card h1,
    .missing-route h1 {
        margin-top: 0;
        margin-bottom: 0.6rem;
        font-size: 2rem;
    }

    .app-loading-card p,
    .missing-route p {
        margin: 0;
        color: var(--text-muted);
    }

    .app-loader-mark {
        width: 112px;
        height: 112px;
        margin: 0 auto 1.35rem;
        position: relative;
        display: grid;
        place-items: center;
    }

    .loader-orbit,
    .loader-core {
        position: absolute;
        inset: 0;
        border-radius: 50%;
    }

    .loader-orbit {
        border: 2px solid color-mix(in srgb, var(--primary-color) 20%, transparent);
    }

    .orbit-one {
        border-top-color: var(--primary-color);
        animation: appLoaderSpin 1.15s linear infinite;
    }

    .orbit-two {
        inset: 10px;
        border-color: color-mix(in srgb, var(--text-color) 12%, transparent);
        border-bottom-color: color-mix(in srgb, var(--primary-color) 70%, white 30%);
        animation: appLoaderSpinReverse 1.7s linear infinite;
    }

    .loader-core {
        inset: 26px;
        background:
            radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.38), transparent 55%),
            color-mix(in srgb, var(--primary-color) 14%, var(--card-bg));
        border: 1px solid color-mix(in srgb, var(--primary-color) 24%, var(--card-border));
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.12);
        display: grid;
        place-items: center;
        color: var(--primary-color);
    }

    .loader-core svg {
        width: 30px;
        height: 30px;
    }

    .app-loader-dots {
        display: inline-flex;
        gap: 0.45rem;
        margin-top: 1rem;
    }

    .app-loader-dots span {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary-color) 82%, white 18%);
        animation: appLoaderPulse 1.1s ease-in-out infinite;
    }

    .app-loader-dots span:nth-child(2) {
        animation-delay: 0.16s;
    }

    .app-loader-dots span:nth-child(3) {
        animation-delay: 0.32s;
    }

    @@keyframes appLoaderSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @@keyframes appLoaderSpinReverse {
        from { transform: rotate(360deg); }
        to { transform: rotate(0deg); }
    }

    @@keyframes appLoaderPulse {
        0%, 100% { transform: translateY(0) scale(0.88); opacity: 0.45; }
        50% { transform: translateY(-2px) scale(1); opacity: 1; }
    }
</style>

@code {
    private bool isReady;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthStateChanged += HandleAuthStateChanged;
        await ThemeService.InitializeAsync();
        await DbService.InitializeAsync();
        await AuthService.InitializeAsync();
        await NotificationService.InitializeAsync();
        isReady = true;
    }

    public void Dispose()
    {
        AuthService.AuthStateChanged -= HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private bool ShouldRedirectToLogin()
    {
        var route = GetCurrentRoute();
        return !AuthService.IsAuthenticated && !IsPublicRoute(route);
    }

    private bool ShouldRedirectToApp()
    {
        var route = GetCurrentRoute();
        return AuthService.IsAuthenticated && IsAuthRoute(route);
    }

    private string GetLoginUrl()
    {
        var currentRelativePath = NavManager.ToBaseRelativePath(NavManager.Uri);
        var returnUrl = "/" + currentRelativePath.TrimStart('/');
        return $"/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    }

    private string GetCurrentRoute()
    {
        var relativePath = NavManager.ToBaseRelativePath(NavManager.Uri);
        var queryIndex = relativePath.IndexOf('?');

        if (queryIndex >= 0)
        {
            relativePath = relativePath[..queryIndex];
        }

        return relativePath.Trim('/');
    }

    private static bool IsPublicRoute(string route)
    {
        return string.IsNullOrWhiteSpace(route)
            || route.Equals("login", StringComparison.OrdinalIgnoreCase)
            || route.Equals("signup", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsAuthRoute(string route)
    {
        return string.IsNullOrWhiteSpace(route)
            || route.Equals("login", StringComparison.OrdinalIgnoreCase)
            || route.Equals("signup", StringComparison.OrdinalIgnoreCase);
    }
}
