@inherits LayoutComponentBase
@implements IDisposable
@inject NotificationService NotificationService
@inject ThemeService ThemeService

<BackgroundLayer />

<div class="page-container fade-in">
    <button type="button"
            class="mode-toggle glass-button @(ThemeService.CurrentMode == "dark" ? "active" : "")"
            title="Toggle light and dark mode"
            aria-label="Toggle light and dark mode"
            @onclick="ToggleMode">
        @if (ThemeService.CurrentMode == "dark")
        {
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" x2="12" y1="1" y2="3"></line>
                <line x1="12" x2="12" y1="21" y2="23"></line>
                <line x1="4.22" x2="5.64" y1="4.22" y2="5.64"></line>
                <line x1="18.36" x2="19.78" y1="18.36" y2="19.78"></line>
                <line x1="1" x2="3" y1="12" y2="12"></line>
                <line x1="21" x2="23" y1="12" y2="12"></line>
                <line x1="4.22" x2="5.64" y1="19.78" y2="18.36"></line>
                <line x1="18.36" x2="19.78" y1="5.64" y2="4.22"></line>
            </svg>
            <span>Light</span>
        }
        else
        {
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path>
            </svg>
            <span>Dark</span>
        }
    </button>

    <main class="content-wrapper">
        @Body
    </main>
</div>

<DockNavigation />

<style>
    .page-container {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .mode-toggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 120;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        min-width: 96px;
        border-radius: 999px;
        padding: 0.7rem 0.95rem;
    }

    .mode-toggle.active {
        background: var(--primary-color);
        color: var(--primary-contrast);
        border-color: transparent;
    }

    .mode-toggle span {
        font-size: 0.85rem;
        font-weight: 700;
        line-height: 1;
    }

    .content-wrapper {
        flex: 1;
        width: 100%;
        max-width: none;
        margin: 0;
        padding-left: var(--desktop-nav-clearance);
        padding-bottom: var(--app-nav-clearance);
        padding-right: var(--layout-shell-gap);
    }

    @@media (max-width: 720px) {
        .mode-toggle {
            top: 0.9rem;
            right: 0.9rem;
            min-width: 48px;
            width: 48px;
            height: 48px;
            padding: 0;
        }

        .mode-toggle span {
            display: none;
        }

        .content-wrapper {
            padding-left: 0;
            padding-right: 0;
        }
    }
</style>

@code {
    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
    }

    private async Task ToggleMode()
    {
        await ThemeService.ToggleModeAsync();
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
    }
}
