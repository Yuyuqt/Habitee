@inherits LayoutComponentBase
@inject NotificationService NotificationService

<BackgroundLayer />

<div class="page-container fade-in">
    <main class="content-wrapper">
        @Body
    </main>
</div>

<DockNavigation />

<style>
    .page-container {
        position: relative;
        z-index: 1;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .content-wrapper {
        flex: 1;
        width: 100%;
        max-width: none;
        margin: 0;
        padding-left: var(--desktop-nav-clearance);
        padding-bottom: var(--app-nav-clearance);
        padding-right: var(--layout-shell-gap);
    }

    @@media (max-width: 720px) {
        .content-wrapper {
            padding-left: 0;
            padding-right: 0;
        }
    }
</style>

