@using Habitee.Services
@inject ThemeService ThemeService
@implements IDisposable

<div class="background-layer" style="z-index: -1;">
    @if (ThemeService.CurrentTheme == "habitee")
    {
        for (int i = 0; i < 15; i++)
        {
            <div class="particle square" style="left: @(RandomNumber(5, 95))vw; top: @(RandomNumber(50, 150))vh; animation-duration: @(RandomNumber(10, 25))s; animation-delay: @(RandomNumber(0, 10))s;"></div>
        }
    }
    else if (ThemeService.CurrentTheme == "pastel")
    {
        for (int i = 0; i < 30; i++)
        {
            <div class="particle star" style="left: @(RandomNumber(5, 95))vw; top: @(RandomNumber(-20, 10))vh; animation-duration: @(RandomNumber(8, 20))s; animation-delay: @(RandomNumber(0, 10))s;">✨</div>
        }
    }
    else if (ThemeService.CurrentTheme == "galaxy")
    {
        for (int i = 0; i < 40; i++)
        {
            <div class="particle sparkle" style="left: @(RandomNumber(0, 100))vw; top: @(RandomNumber(0, 100))vh; animation-duration: @(RandomNumber(2, 6))s; animation-delay: @(RandomNumber(0, 5))s;"></div>
        }
    }
    else if (ThemeService.CurrentTheme == "cyberpunk")
    {
        <div class="cyber-grid"></div>
    }
</div>

<style>
    .background-layer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        overflow: hidden;
    }

    .particle {
        position: absolute;
    }

    /* Squares */
    .square {
        width: 40px;
        height: 40px;
        background-color: var(--primary-color);
        border-radius: 8px;
        opacity: 0;
        animation-name: floatSquare;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    /* Stars */
    .star {
        font-size: 1.5rem;
        opacity: 0;
        animation-name: fallStar;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
    }

    /* Sparkles */
    .sparkle {
        width: 4px;
        height: 4px;
        background-color: white;
        border-radius: 50%;
        box-shadow: 0 0 10px 2px rgba(255, 255, 255, 0.8);
        animation-name: twinkleSparkle;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    /* Cyber Grid */
    .cyber-grid {
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background-image: 
            linear-gradient(rgba(6, 182, 212, 0.2) 1px, transparent 1px),
            linear-gradient(90deg, rgba(6, 182, 212, 0.2) 1px, transparent 1px);
        background-size: 40px 40px;
        transform: perspective(500px) rotateX(60deg);
        animation: moveGrid 3s linear infinite;
    }
</style>

@code {
    private Random rnd = new Random();

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }

    private int RandomNumber(int min, int max)
    {
        return rnd.Next(min, max);
    }
}
