<style>
    .background-layer {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        overflow: hidden;
        background-color: var(--bg-color);
        transition: background-color 0.3s ease;
    }

    .bg-wave {
        position: absolute;
        width: 100vw;
        height: 22vh; /* Responsive height */
        min-height: 180px;
        max-height: 350px;
        left: 0;
        /* Using color-mix to tint the waves subtly in dark mode if needed, but var() directly works well too */
    }

    .wave-top {
        top: 0;
    }

    .wave-bottom {
        bottom: 0;
    }

    /* Stack elegantly on mobile */
    @@media (max-width: 768px) {
        .bg-wave {
            height: 18vh; 
            min-height: 140px;
        }
    }
</style>
