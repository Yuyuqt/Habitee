@page "/signup"
@layout Habitee.Layout.PublicLayout
@inject AuthService AuthService
@inject NavigationManager NavManager

<PageTitle>Create Account - Habitee</PageTitle>

<div class="auth-page">
    <div class="auth-card glass-panel">
        <button class="back-link" @onclick='() => NavManager.NavigateTo("/")'>← Back to preview</button>
        <h1>Create your local account</h1>
        <p class="auth-subtitle">Everything stays on this device unless you export it yourself.</p>

        <div class="auth-form">
            <div class="input-group">
                <label>Display name</label>
                <input class="glass-input" @bind="displayName" @bind:event="oninput" />
            </div>

            <div class="input-group">
                <label>Email</label>
                <input class="glass-input" @bind="email" @bind:event="oninput" type="email" />
            </div>

            <div class="input-group">
                <label>Password</label>
                <input class="glass-input" @bind="password" @bind:event="oninput" type="password" />
            </div>

            <div class="input-group">
                <label>Confirm password</label>
                <input class="glass-input" @bind="confirmPassword" @bind:event="oninput" type="password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="auth-error">@errorMessage</div>
            }

            <button class="glass-button auth-primary" @onclick="SignUp" disabled="@isSubmitting">
                @(isSubmitting ? "Creating account..." : "Create Account")
            </button>

            <p class="auth-footer">
                Already have an account?
                <button class="inline-link" @onclick="GoToLogin">Log in here</button>
            </p>
        </div>
    </div>
</div>

<style>
    .auth-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .auth-card {
        width: 100%;
        max-width: 460px;
        padding: 2rem;
    }

    .back-link,
    .inline-link {
        border: none;
        background: none;
        color: var(--primary-color);
        padding: 0;
        cursor: pointer;
        font: inherit;
    }

    .auth-card h1 {
        margin-bottom: 0.4rem;
    }

    .auth-subtitle,
    .auth-footer {
        color: var(--text-muted);
    }

    .auth-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
    }

    .input-group label {
        font-weight: 700;
        font-size: 0.85rem;
    }

    .glass-input {
        width: 100%;
        padding: 1rem;
        border-radius: 16px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        font: inherit;
    }

    .auth-primary {
        background: var(--primary-color);
        color: white;
        border-color: transparent;
        padding: 1rem;
    }

    .auth-error {
        padding: 0.9rem 1rem;
        border-radius: 14px;
        background: rgba(244, 63, 94, 0.12);
        color: #f43f5e;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private string displayName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private string errorMessage = string.Empty;
    private bool isSubmitting;

    private async Task SignUp()
    {
        errorMessage = string.Empty;

        if (!string.Equals(password, confirmPassword, StringComparison.Ordinal))
        {
            errorMessage = "Passwords need to match.";
            return;
        }

        isSubmitting = true;
        var result = await AuthService.SignUpAsync(displayName, email, password);
        isSubmitting = false;

        if (!result.Success)
        {
            errorMessage = result.ErrorMessage ?? "Signup failed.";
            return;
        }

        NavManager.NavigateTo(GetSafeReturnUrl(), replace: true);
    }

    private void GoToLogin()
    {
        NavManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(GetSafeReturnUrl())}");
    }

    private string GetSafeReturnUrl()
    {
        return !string.IsNullOrWhiteSpace(ReturnUrl) && ReturnUrl.StartsWith("/") && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : "/app";
    }
}
