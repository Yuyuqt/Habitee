        background: var(--primary-color);
    }

    .inline-action-btn {
        padding: 1rem 0;
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .primary-btn {
        width: 100%;
        max-width: 400px;
        background: var(--primary-color);
        border-color: var(--primary-color);
        padding: 1rem;
        font-size: var(--font-size-card-title);
        border-radius: 16px;
        box-shadow: none;
        pointer-events: auto;
        color: var(--primary-contrast);
    }

    @("@media") (max-width: 720px) {
        .view-container {
            padding-top: 1.5rem;
        }

        .app-header {
            padding: 1.5rem 1rem 1rem;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .header-title {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
            padding: 0 0.5rem;
        }

        .tabs-container {
