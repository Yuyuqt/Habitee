@page "/add-habit"
@inject NavigationManager NavManager

<div class="view-container slide-in">
    <header class="app-header">
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/app")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <h1 class="header-title">Add Habits</h1>
        <div style="width: 24px;"></div> <!-- Spacer -->
    </header>

    <div class="tabs-container">
        <div class="tabs-wrapper glass-panel">
            <button class="tab-btn @(currentTab == "positive" ? "active" : "")" @onclick='() => currentTab = "positive"'>Positive</button>
            <button class="tab-btn @(currentTab == "negative" ? "active" : "")" @onclick='() => currentTab = "negative"'>Negative</button>
        </div>
    </div>

    <div class="search-container">
        <input type="text" class="glass-input search-input" placeholder="Search" @bind="searchQuery" @bind:event="oninput" />
    </div>

    <div class="content-scroll">
        @if (currentTab == "positive")
        {
            @foreach (var category in FilteredCategories)
            {
                <div class="category-section">
                    <h3 class="category-title">@category.CategoryName.ToUpper()</h3>
                    <div class="template-list">
                        @foreach (var template in category.Items)
                        {
                            <div class="template-card glass-panel" @onclick="() => SelectTemplate(template)">
                                <HabitIcon Name="@template.Icon" Color="@template.Color" Size="24" />
                                <div class="template-info">
                                    <h4>@template.Title</h4>
                                    <p>@template.Description</p>
                                </div>
                                <div class="checkbox"></div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>Negative habits tracking coming soon!</p>
            </div>
        }
        
        <!-- Bottom Spacer to ensure last items are clickable above fixed button -->
        <div style="height: 100px;"></div>
    </div>

    <div class="fixed-bottom">
        <button class="primary-btn glass-button" @onclick='() => NavManager.NavigateTo("/new-habit?reset=true")'>
            Create Custom Habit
        </button>
    </div>
</div>

<style>
    .view-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        max-width: 800px;
        margin: 0 auto;
        position: relative;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
    }

    .header-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tabs-container {
        padding: 0 1.5rem;
        margin-bottom: 1rem;
    }

    .tabs-wrapper {
        display: flex;
        padding: 0.25rem;
        border-radius: 12px;
    }

    .tab-btn {
        flex: 1;
        padding: 0.5rem;
        border: none;
        background: transparent;
        color: var(--text-muted);
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .tab-btn.active {
        background: var(--primary-color);
        color: white;
    }

    .search-container {
        padding: 0 1.5rem 1rem 1.5rem;
    }

    .glass-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        backdrop-filter: blur(10px);
        font-family: inherit;
        font-size: 1rem;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem;
    }

    .category-section {
        margin-bottom: 2rem;
    }

    .category-title {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 1rem;
        letter-spacing: 1px;
    }

    .template-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .template-card {
        display: flex;
        align-items: center;
        padding: 1rem;
        gap: 1rem;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .template-card:active {
        transform: scale(0.98);
    }



    .template-info {
        flex: 1;
    }

    .template-info h4 {
        margin: 0 0 0.25rem 0;
        font-size: 1.1rem;
    }

    .template-info p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .checkbox {
        width: 24px;
        height: 24px;
        border: 2px solid var(--card-border);
        border-radius: 6px;
    }

    .fixed-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1.5rem;
        background: linear-gradient(to top, var(--bg-color) 60%, transparent);
        display: flex;
        justify-content: center;
    }

    .primary-btn {
        width: 100%;
        max-width: 400px;
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
        padding: 1rem;
        font-size: 1.1rem;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
</style>

@code {
    private string currentTab = "positive";
    private string searchQuery = "";

    private IEnumerable<HabitCategory> FilteredCategories => positiveTemplates
        .Select(c => new HabitCategory 
        { 
            CategoryName = c.CategoryName, 
            Items = c.Items.Where(i => string.IsNullOrEmpty(searchQuery) || i.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)).ToList() 
        })
        .Where(c => c.Items.Any());

    private void SelectTemplate(HabitTemplate template)
    {
        // Pass parameters to new-habit form via query string
        NavManager.NavigateTo($"/new-habit?reset=true&title={Uri.EscapeDataString(template.Title)}&desc={Uri.EscapeDataString(template.Description)}&icon={template.Icon}&color={Uri.EscapeDataString(template.Color)}");
    }

    private class HabitCategory
    {
        public string CategoryName { get; set; } = "";
        public List<HabitTemplate> Items { get; set; } = new();
    }

    private class HabitTemplate
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "check";
        public string Color { get; set; } = "#3b82f6";
    }

    // Hardcoded templates based on screenshots
    private List<HabitCategory> positiveTemplates = new()
    {
        new HabitCategory
        {
            CategoryName = "Diet & Nutrition",
            Items = new()
            {
                new HabitTemplate { Title = "Stop Skipping Meals", Description = "Eat regular meals every day", Icon = "cutlery", Color = "#f97316" },
                new HabitTemplate { Title = "No Junk Food", Description = "Avoid processed junk food", Icon = "burger", Color = "#f97316" },
                new HabitTemplate { Title = "No Soda", Description = "Cut out sugary soft drinks", Icon = "soda", Color = "#f97316" },
                new HabitTemplate { Title = "No Sugar", Description = "Cut added sugar from your diet", Icon = "sugar", Color = "#f97316" }
            }
        },
        new HabitCategory
        {
            CategoryName = "Health & Wellness",
            Items = new()
            {
                new HabitTemplate { Title = "Meditate", Description = "Practice mindfulness daily", Icon = "meditate", Color = "#10b981" },
                new HabitTemplate { Title = "Drink Water", Description = "Stay hydrated throughout the day", Icon = "water", Color = "#10b981" },
                new HabitTemplate { Title = "Take Vitamins", Description = "Take your daily supplements", Icon = "pill", Color = "#10b981" },
                new HabitTemplate { Title = "Floss", Description = "Floss your teeth daily", Icon = "tooth", Color = "#10b981" }
            }
        }
    };
}
