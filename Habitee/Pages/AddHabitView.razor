        }

        .template-info h4 {
            font-size: 0.96rem;
        }

        .template-info p {
            font-size: 0.8rem;
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
        }

        .checkbox {
            width: 22px;
            height: 22px;
        }

        .primary-btn {
            padding: 0.9rem;
        }
    }

    @("@media") (max-width: 540px) {
        .template-card {
            align-items: flex-start;
        }

        .checkbox {
            width: 28px;
            height: 28px;
        }
    }
</style>

@code {
    private string currentTab = "positive";
    private string searchQuery = "";
    private bool showBackButton;
    private bool isSavingSelection;
    private readonly HashSet<HabitTemplate> selectedTemplates = new();
    private int SelectedCount => selectedTemplates.Count;

    protected override async Task OnInitializedAsync()
    {
        var activeHabits = await DbService.GetActiveHabitsAsync();
        showBackButton = activeHabits.Any();
    }

    private List<HabitCategory> CurrentTemplates => currentTab == "positive" ? positiveTemplates : negativeTemplates;

    private IEnumerable<HabitCategory> FilteredCategories => CurrentTemplates
        .Select(c => new HabitCategory
        {
            CategoryName = c.CategoryName,
            Items = c.Items.Where(i =>
                    string.IsNullOrEmpty(searchQuery)
                    || i.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                    || i.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                .ToList()
        })
        .Where(c => c.Items.Any());

    private void HandleTemplateClick(HabitTemplate template)
    {
        if (SelectedCount > 0)
        {
            ToggleTemplateSelection(template);
            return;
        }

        NavManager.NavigateTo($"/new-habit?reset=true&title={Uri.EscapeDataString(template.Title)}&desc={Uri.EscapeDataString(template.Description)}&icon={template.Icon}&color={Uri.EscapeDataString(template.Color)}");
    }

    private bool IsSelected(HabitTemplate template) => selectedTemplates.Contains(template);

    private void ToggleTemplateSelection(HabitTemplate template)
    {
        if (!selectedTemplates.Add(template))
        {
            selectedTemplates.Remove(template);
        }
    }

    private async Task HandlePrimaryAction()
    {
        if (SelectedCount == 0)
        {
            NavManager.NavigateTo("/new-habit?reset=true");
            return;
        }

        if (isSavingSelection)
        {
            return;
        }

        isSavingSelection = true;

        try
        {
            foreach (var template in selectedTemplates)
            {
                var habit = new Habit
                {
                    Title = template.Title,
                    Description = template.Description,
                    Icon = template.Icon,
                    Color = template.Color
                };

                await DbService.SaveHabitAsync(habit);
            }

            selectedTemplates.Clear();
            NavManager.NavigateTo("/app");
        }
        finally
        {
            isSavingSelection = false;
        }
    }

    private class HabitCategory
