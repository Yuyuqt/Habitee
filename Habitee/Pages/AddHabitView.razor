@page "/add-habit"
@using Habitee.Models
@using Habitee.Services
@inject DatabaseService DbService
@inject NavigationManager NavManager

<div class="view-container slide-in">
    <header class="app-header">
        @if (showBackButton)
        {
            <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/app")'>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
        }
        else
        {
            <div style="width: 24px;"></div>
        }
        <h1 class="header-title">Add Habits</h1>
        <button class="header-action" type="button" @onclick='() => NavManager.NavigateTo("/new-habit?reset=true")'>
            Create custom habit
        </button>
    </header>

    <div class="search-container">
        <input type="text" class="glass-input search-input" placeholder="Search" @bind="searchQuery" @bind:event="oninput" />
    </div>

    <div class="tabs-container">
        <div class="tabs-wrapper glass-panel">
            <button class="tab-btn @(currentTab == "positive" ? "active" : "")" @onclick='() => currentTab = "positive"'>Positive</button>
            <button class="tab-btn @(currentTab == "negative" ? "active" : "")" @onclick='() => currentTab = "negative"'>Negative</button>
        </div>
    </div>

    <div class="content-scroll">
        @if (FilteredCategories.Any())
        {
            @foreach (var category in FilteredCategories)
            {
                <div class="category-section">
                    <h3 class="category-title">@category.CategoryName.ToUpper()</h3>
                    <div class="template-list">
                        @foreach (var template in category.Items)
                        {
                            <div class="template-card glass-panel @(IsSelected(template) ? "selected" : "")"
                                 @onclick="() => HandleTemplateClick(template)">
                                <HabitIcon Name="@template.Icon" Color="@template.Color" Size="22" />
                                <div class="template-info">
                                    <h4>@template.Title</h4>
                                    <p>@template.Description</p>
                                </div>
                                <button type="button"
                                        class="checkbox @(IsSelected(template) ? "selected" : "")"
                                        aria-label="Select template"
                                        aria-pressed="@IsSelected(template)"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => ToggleTemplateSelection(template)">
                                    @if (IsSelected(template))
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="20 6 9 17 4 12"></polyline>
                                        </svg>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>No templates match your search.</p>
            </div>
        }
                @if (SelectedCount > 0)
        {
            <div class="inline-action-btn">
                <button class="primary-btn glass-button"
                        disabled="@isSavingSelection"
                        @onclick="HandlePrimaryAction">
                    @(isSavingSelection ? "Adding..." : $"Add Selected Habits ({SelectedCount})")
                </button>
            </div>
        }
        <div style="height: 2rem;"></div>
    </div>
</div>

<style>
