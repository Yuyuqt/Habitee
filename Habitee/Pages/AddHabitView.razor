        justify-content: space-between;
        align-items: center;
        padding: 2rem 1.5rem 1.5rem;
    }

    .header-title {
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
        margin: 0;
        text-align: center;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 0 1rem;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tabs-container {
        padding: 0 1.5rem;
        margin-bottom: 1rem;
    }

    .tabs-wrapper {
        display: flex;
        padding: 0;
        border-radius: 14px;
        overflow: hidden;
        border: var(--outline-width, 1px) solid var(--card-border);
    }

    .tab-btn {
        flex: 1;
        padding: 0.75rem;
        border: none;
        background: transparent;
        color: var(--text-muted);
        font-weight: 600;
        border-radius: 0;
        cursor: pointer;
        transition: all 0.2s;
        font-size: var(--font-size-body-sm);
    }

    .tab-btn.active {
        background: var(--primary-color);
        color: var(--primary-contrast);
    }

    .tab-btn:hover:not(.active) {
        background: color-mix(in srgb, var(--button-hover-surface) 86%, transparent);
        color: var(--text-color);
    }

    .search-container {
        padding: 0 1.5rem 1rem 1.5rem;
    }

    .glass-input {
        width: 100%;
        padding: 0.75rem 1rem;
        border-radius: 12px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        backdrop-filter: blur(10px);
        font-family: inherit;
        font-size: var(--font-size-body);
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem;
        padding-bottom: calc(var(--page-action-clearance) + 1rem);
    }

    .category-section {
        margin-bottom: 2rem;
    }

    .category-title {
        font-size: var(--font-size-body-xs);
        color: var(--text-muted);
        margin-bottom: 1rem;
        letter-spacing: 1px;
    }

    .template-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .template-card {
        display: flex;
        align-items: center;
        padding: 1rem;
        gap: 1rem;
        cursor: pointer;
        transition: border-color 0.16s ease, box-shadow 0.16s ease, background-color 0.16s ease;
    }



    .template-info {
        flex: 1;
    }

    .template-info h4 {
        margin: 0 0 0.25rem 0;
        font-size: var(--font-size-card-title);
    }

    .template-info p {
        margin: 0;
        font-size: var(--font-size-body-xs);
        color: var(--text-muted);
    }

    .checkbox {
        width: 24px;
        height: 24px;
        border: 2px solid var(--card-border);
        border-radius: 6px;
    }

    .fixed-bottom {
        position: fixed;
        bottom: var(--page-action-offset);
        left: var(--desktop-nav-clearance);
        right: 0;
        padding: 0 1.5rem;
        display: flex;
        justify-content: center;
        pointer-events: none;
        z-index: 5;
    }

    .primary-btn {
        width: 100%;
        max-width: 400px;
        background: var(--primary-color);
        border-color: var(--primary-color);
        padding: 1rem;
        font-size: var(--font-size-card-title);
        border-radius: 16px;
        box-shadow: none;
        pointer-events: auto;
        color: var(--primary-contrast);
    }

    @@media (max-width: 720px) {
        .view-container {
            padding-top: 1.5rem;
        }
        .fixed-bottom {
            left: 0;
            padding: 0 1rem;
        }
    }
</style>

@code {
    private string currentTab = "positive";
    private string searchQuery = "";
    private bool showBackButton;

    protected override async Task OnInitializedAsync()
    {
        var activeHabits = await DbService.GetActiveHabitsAsync();
        showBackButton = activeHabits.Any();
    }

    private List<HabitCategory> CurrentTemplates => currentTab == "positive" ? positiveTemplates : negativeTemplates;

    private IEnumerable<HabitCategory> FilteredCategories => CurrentTemplates
        .Select(c => new HabitCategory 
        { 
            CategoryName = c.CategoryName, 
            Items = c.Items.Where(i =>
                    string.IsNullOrEmpty(searchQuery)
                    || i.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                    || i.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                .ToList()
        })
        .Where(c => c.Items.Any());

    private void SelectTemplate(HabitTemplate template)
    {
        // Pass parameters to new-habit form via query string
        NavManager.NavigateTo($"/new-habit?reset=true&title={Uri.EscapeDataString(template.Title)}&desc={Uri.EscapeDataString(template.Description)}&icon={template.Icon}&color={Uri.EscapeDataString(template.Color)}");
