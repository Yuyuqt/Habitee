        }

        .tabs-container {
            margin-bottom: 0.75rem;
        }

        .tab-btn {
            padding: 0.68rem;
        }

        .search-container {
            padding: 0 1rem 0.8rem 1rem;
        }

        .content-scroll {
            padding: 0 1rem;
        }

        .category-section {
            margin-bottom: 1.1rem;
        }

        .template-card {
            padding: 0.72rem 0.8rem;
            gap: 0.72rem;
