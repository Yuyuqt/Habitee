@page "/settings/active-reminders"
@using Habitee.Components
@using Habitee.Models
@using Habitee.Services
@implements IDisposable
@inject DatabaseService DbService
@inject NavigationManager NavManager

<div class="library-view slide-in">
    <header class="library-header">
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/settings")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <div class="library-title-group">
            <h1>Active Reminders</h1>
            <p>Habits with at least one reminder still switched on.</p>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="library-empty glass-panel">
            <p>Loading reminder-ready habits...</p>
        </div>
    }
    else if (!habits.Any())
    {
        <div class="library-empty glass-panel">
            <h2>No active reminders yet</h2>
            <p>Turn on a reminder for any active habit and it will show up here.</p>
        </div>
    }
    else
    {
        <div class="library-list">
            @foreach (var habit in habits)
            {
                <button class="library-card glass-panel"
                        @onclick='() => NavManager.NavigateTo($"/habit/{habit.Id}")'>
                    <div class="library-card-top">
                        <div class="library-habit-copy">
                            <div class="library-icon-ring" style="@($"--habit-color: {habit.Color};")">
                                <HabitIcon Name="@habit.Icon" Color="@habit.Color" Size="22" />
                            </div>
                            <div>
                                <h3>@habit.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(habit.Description))
                                {
                                    <p>@habit.Description</p>
                                }
                            </div>
                        </div>

                        <span class="library-count-pill">@GetEnabledReminderCount(habit) active</span>
                    </div>

                    <div class="reminder-chip-row">
                        @foreach (var reminderTime in GetEnabledReminderTimes(habit))
                        {
                            <span class="reminder-chip">@reminderTime</span>
                        }
                    </div>
                </button>
            }
        </div>
    }
</div>

<style>
    .library-view {
        max-width: 820px;
        margin: 0 auto;
        padding: 1.5rem;
    }

    .library-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1.5rem;
        padding-top: 0.5rem;
    }

    .library-title-group h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 800;
    }

    .library-title-group p {
        margin: 0.35rem 0 0;
        color: var(--text-muted);
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .library-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .library-card {
        width: 100%;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        text-align: left;
        padding: 1.2rem;
        border-radius: 22px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        box-shadow: var(--card-shadow);
    }

    .library-card-top {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
    }

    .library-habit-copy {
        display: flex;
        gap: 0.9rem;
        min-width: 0;
    }

    .library-icon-ring {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--habit-color) 45%, var(--card-border));
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--habit-color) 12%, transparent);
        flex-shrink: 0;
    }

    .library-habit-copy h3 {
        margin: 0;
        font-size: 1.08rem;
    }

    .library-habit-copy p {
        margin: 0.3rem 0 0;
        color: var(--text-muted);
    }

    .library-count-pill {
        padding: 0.5rem 0.8rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--primary-color) 14%, transparent);
        color: var(--primary-color);
        font-size: 0.82rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .reminder-chip-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
    }

    .reminder-chip {
        padding: 0.45rem 0.8rem;
        border-radius: 999px;
        background: var(--card-border);
        color: var(--text-color);
        font-size: 0.84rem;
        font-weight: 600;
    }

    .library-empty {
        padding: 2rem;
        text-align: center;
    }

    .library-empty h2 {
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    .library-empty p {
        margin: 0;
        color: var(--text-muted);
    }

    @@media (max-width: 720px) {
        .library-view {
            padding: 1rem;
        }

        .library-header {
            align-items: center;
        }

        .library-card-top {
            flex-direction: column;
        }

        .library-count-pill {
            align-self: flex-start;
        }
    }
</style>

@code {
    private List<Habit> habits = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        DbService.DataChanged += HandleDatabaseChanged;
        await LoadHabitsAsync();
    }

    public void Dispose()
    {
        DbService.DataChanged -= HandleDatabaseChanged;
    }

    private async Task LoadHabitsAsync()
    {
        isLoading = true;
        habits = (await DbService.GetHabitsWithActiveRemindersAsync())
            .OrderBy(habit => habit.Title)
            .ToList();
        isLoading = false;
        StateHasChanged();
    }

    private void HandleDatabaseChanged()
    {
        _ = InvokeAsync(LoadHabitsAsync);
    }

    private static int GetEnabledReminderCount(Habit habit)
    {
        return habit.Reminders.Count(reminder => reminder.Enabled);
    }

    private static List<string> GetEnabledReminderTimes(Habit habit)
    {
        return habit.Reminders
            .Where(reminder => reminder.Enabled)
            .OrderBy(reminder => reminder.TimeLocal)
            .Select(reminder => reminder.TimeLocal)
            .ToList();
    }
}
