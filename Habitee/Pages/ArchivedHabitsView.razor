@page "/settings/archived-habits"
@using Habitee.Components
@using Habitee.Models
@using Habitee.Services
@implements IDisposable
@inject DatabaseService DbService
@inject NavigationManager NavManager

<div class="library-view slide-in">
    <header class="library-header">
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/settings")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <div class="library-title-group">
            <h1>Archived Habits</h1>
            <p>Hidden habits live here until you restore or remove them.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="library-status fade-in">@statusMessage</div>
    }

    @if (isLoading)
    {
        <div class="library-empty glass-panel">
            <p>Loading archived habits...</p>
        </div>
    }
    else if (!habits.Any())
    {
        <div class="library-empty glass-panel">
            <h2>No archived habits</h2>
            <p>Archive a habit when you want a quieter daily view without deleting your progress.</p>
        </div>
    }
    else
    {
        <div class="library-list">
            @foreach (var habit in habits)
            {
                <div class="archived-card glass-panel" @onclick='() => NavManager.NavigateTo($"/habit/{habit.Id}")'>
                    <div class="archived-card-top">
                        <div class="library-habit-copy">
                            <div class="library-icon-ring" style="@($"--habit-color: {habit.Color};")">
                                <HabitIcon Name="@habit.Icon" Color="@habit.Color" Size="22" />
                            </div>
                            <div>
                                <h3>@habit.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(habit.Description))
                                {
                                    <p>@habit.Description</p>
                                }
                                <span>Archived @GetArchivedLabel(habit)</span>
                            </div>
                        </div>
                    </div>

                    <div class="archived-actions">
                        <button class="glass-button archived-action restore"
                                @onclick="() => RestoreHabit(habit.Id)"
                                @onclick:stopPropagation="true">
                            Unarchive
                        </button>
                        <button class="glass-button archived-action delete"
                                @onclick='() => AskDelete(habit.Id, habit.Title)'
                                @onclick:stopPropagation="true">
                            Delete
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (showDeleteConfirm)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="confirm-modal glass-panel" @onclick:stopPropagation="true">
            <h3>Delete this archived habit?</h3>
            <p>@pendingDeleteHabitTitle cannot be restored after deletion.</p>
            <div class="confirm-actions">
                <button class="glass-button" @onclick="CancelDelete">No</button>
                <button class="glass-button confirm-delete" @onclick="ConfirmDelete">Yes</button>
            </div>
        </div>
    </div>
}

<style>
    .library-view {
        max-width: 820px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 1.5rem;
    }

    .library-header {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .library-title-group h1 {
        margin: 0;
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
    }

    .library-title-group p {
        margin: 0.35rem 0 0;
        color: var(--text-muted);
        font-size: var(--font-size-body);
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .library-status {
        margin-bottom: 1rem;
        padding: 1rem;
        border-radius: 14px;
        background: var(--card-border);
        color: var(--text-color);
    }

    .library-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .archived-card {
        padding: 1.2rem;
        border-radius: 22px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        cursor: pointer;
    }

    .archived-card-top {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        align-items: flex-start;
    }

    .library-habit-copy {
        display: flex;
        gap: 0.9rem;
        min-width: 0;
    }

    .library-icon-ring {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--habit-color) 45%, var(--card-border));
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--habit-color) 12%, transparent);
        flex-shrink: 0;
    }

    .library-habit-copy h3 {
        margin: 0;
        font-size: var(--font-size-card-title);
    }

    .library-habit-copy p {
        margin: 0.3rem 0 0;
        color: var(--text-muted);
        font-size: var(--font-size-body-sm);
    }

    .library-habit-copy span {
        display: inline-block;
        margin-top: 0.45rem;
        color: var(--text-muted);
        font-size: var(--font-size-body-xs);
        font-weight: 600;
    }

    .archived-actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .archived-action {
        padding: 0.9rem 1rem;
    }

    .archived-action.restore {
        color: var(--primary-color);
    }

    .archived-action.delete {
        color: #f43f5e;
        border-color: rgba(244, 63, 94, 0.25);
        background: rgba(244, 63, 94, 0.08);
    }

    .library-empty {
        padding: 2rem;
        text-align: center;
    }

    .library-empty h2 {
        margin-top: 0;
        margin-bottom: 0.5rem;
    }

    .library-empty p {
        margin: 0;
        color: var(--text-muted);
    }

    @("@media") (max-width: 720px) {
        .library-view {
            padding: 1.5rem 1rem 1rem;
        }

        .library-header {
            align-items: center;
        }

        .archived-actions {
            flex-direction: column;
        }
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        background: rgba(8, 10, 16, 0.45);
    }

    .confirm-modal {
        width: min(420px, 100%);
        padding: 1.2rem;
        border-radius: 18px;
        border: 1px solid var(--card-border);
        background: var(--card-bg);
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .confirm-modal h3 {
        margin: 0;
    }

    .confirm-modal p {
        margin: 0;
        color: var(--text-muted);
    }

    .confirm-actions {
        margin-top: 0.25rem;
        display: flex;
        gap: 0.75rem;
        justify-content: flex-end;
    }

    .confirm-actions .confirm-delete {
        color: #ef4444;
        border-color: rgba(244, 63, 94, 0.3);
    }

</style>

@code {
    private string statusMessage = "";
    private List<Habit> habits = new();
    private bool isLoading = true;
    private string? pendingDeleteHabitId;
    private string pendingDeleteHabitTitle = "";
    private bool showDeleteConfirm;

    protected override async Task OnInitializedAsync()
    {
        DbService.DataChanged += HandleDatabaseChanged;
        await LoadHabitsAsync();
    }

    public void Dispose()
    {
        DbService.DataChanged -= HandleDatabaseChanged;
    }

    private async Task LoadHabitsAsync()
    {
        isLoading = true;
        habits = (await DbService.GetArchivedHabitsAsync())
            .OrderByDescending(ParseArchivedAt)
            .ThenBy(habit => habit.Title)
            .ToList();
        isLoading = false;
        StateHasChanged();
    }

    private async Task RestoreHabit(string habitId)
    {
        await DbService.RestoreHabitAsync(habitId);
        statusMessage = "Habit restored to your active list.";
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteHabitPermanently(string habitId)
    {
        await DbService.DeleteHabitAsync(habitId);
        statusMessage = "Archived habit deleted permanently.";
        await InvokeAsync(StateHasChanged);
    }

    private void AskDelete(string habitId, string habitTitle)
    {
        pendingDeleteHabitId = habitId;
        pendingDeleteHabitTitle = habitTitle;
        showDeleteConfirm = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        pendingDeleteHabitId = null;
        pendingDeleteHabitTitle = "";
    }

    private async Task ConfirmDelete()
    {
        if (pendingDeleteHabitId == null)
        {
            return;
        }

        var habitId = pendingDeleteHabitId;
        showDeleteConfirm = false;
        pendingDeleteHabitId = null;
        pendingDeleteHabitTitle = "";

        await DeleteHabitPermanently(habitId);
    }

    private void HandleDatabaseChanged()
    {
        _ = InvokeAsync(LoadHabitsAsync);
    }

    private static string GetArchivedLabel(Habit habit)
    {
        var archivedAt = ParseArchivedAt(habit);
        return archivedAt?.ToLocalTime().ToString("MMM d, yyyy") ?? "recently";
    }

    private static DateTimeOffset? ParseArchivedAt(Habit habit)
    {
        return DateTimeOffset.TryParse(habit.ArchivedAt, out var parsed) ? parsed : null;
    }
}


