@page "/habit/{Id}"
@using Habitee.Models
@using Habitee.Services
@inject DatabaseService DbService
@inject NavigationManager NavManager

<div class="view-container slide-in">
    <header class="app-header">
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/app")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <h1 class="header-title">@habit?.Title</h1>
        <button class="header-action-btn glass-button" @onclick="EditHabit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Edit
        </button>
    </header>

    @if (isLoading)
    {
        <div class="flex-center" style="height: 200px;">
            <p>Loading...</p>
        </div>
    }
    else if (habit != null)
    {
        <div class="content-scroll">
            <!-- Reusing the HabitCard for the top section -->
            <Habitee.Components.HabitCard Habit="habit" Logs="logs" OnComplete="HandleComplete" DisableNavigation="true" />

            <!-- The large interactive calendar -->
            <Habitee.Components.LargeCalendar Habit="habit" Logs="logs" />
                        <div class="bottom-action-pad">
                <button class="archive-btn glass-panel @(habit?.IsArchived == true ? "restore-mode" : "")" @onclick="ToggleArchiveState">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
                    @(habit?.IsArchived == true ? "Unarchive" : "Archive")
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>Habit not found.</p>
            <button class="glass-button" @onclick='() => NavManager.NavigateTo("/app")'>Go Back</button>
        </div>
    }
</div>

<style>
    .view-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        max-width: 800px;
        margin: 0 auto;
        padding-top: 3rem;
        position: relative;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 1.5rem 1.5rem;
    }

    .header-action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.58rem 0.95rem;
        border-radius: 12px;
        border: 1px solid var(--outline-color, var(--card-border));
        background: var(--card-bg);
        color: var(--text-color);
        font-size: var(--font-size-body-sm);
        line-height: 1;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
        box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
    }

    .header-action-btn:hover {
        transform: translateY(-1px);
        background: color-mix(in srgb, var(--primary-color) 8%, var(--card-bg));
        box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
    }

    [data-theme-mode="dark"] .header-action-btn {
        background: color-mix(in srgb, var(--primary-color) 15%, var(--card-bg));
        color: var(--primary-contrast);
        border-color: color-mix(in srgb, var(--primary-color) 38%, transparent);
    }

    [data-theme-mode="dark"] .header-action-btn:hover {
        background: color-mix(in srgb, var(--primary-color) 24%, var(--card-bg));
    }

    .header-title {
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
        margin: 0;
        text-align: center;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 0 1rem;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem;
        padding-bottom: 0.5rem;
    }

    .bottom-action-pad {
        padding: 1.5rem 0 2rem 0;
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .archive-btn {
        width: 100%;
        max-width: 400px;
        background: var(--primary-color);
        color: var(--primary-contrast);
        border: 1px solid transparent;
        padding: 1rem;
        font-size: var(--font-size-card-title);
        font-weight: 600;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        cursor: pointer;
        transition: all 0.2s;
        pointer-events: auto;
    }
    
    .archive-btn:hover {
        background: color-mix(in srgb, var(--primary-color) 88%, black 12%);
        color: var(--primary-contrast);
    }

    .archive-btn.restore-mode {
        background: var(--primary-color);
        color: var(--primary-contrast);
        border-color: transparent;
    }

    .archive-btn.restore-mode:hover {
        background: color-mix(in srgb, var(--primary-color) 88%, black 12%);
        color: var(--primary-contrast);
    }

    @("@media") (max-width: 720px) {
        .view-container {
            padding-top: 2rem;
        }

        .app-header {
            padding: 1.5rem 1rem 1rem;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .header-action-btn {
            padding: 0.52rem 0.85rem;
            gap: 0.35rem;
            font-size: calc(var(--font-size-body-sm) - 0.02rem);
        }

        .header-title {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
            font-size: var(--font-size-page-title);
            padding: 0 0.5rem;
        }

        .content-scroll {
            padding: 0 1rem;
        }
    }

    @("@media") (max-width: 540px) {
        .app-header {
            align-items: flex-start;
        }

        .icon-btn {
            padding: 0.35rem;
        }
    }
</style>

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private Habit? habit;
    private List<HabitLog> logs = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        habit = await DbService.GetHabitByIdAsync(Id);
        
        if (habit != null)
        {
            var allLogs = await DbService.GetLogsAsync();
            logs = allLogs.Where(l => l.HabitId == habit.Id).ToList();
        }
        
        isLoading = false;
        StateHasChanged();
    }

    private void EditHabit()
    {
        if (habit != null)
        {
            NavManager.NavigateTo($"/new-habit?editId={habit.Id}");
        }
    }

    private async Task HandleComplete(Habit completedHabit)
    {
        await DbService.CycleHabitCompletionAsync(completedHabit);
        logs = (await DbService.GetLogsAsync())
            .Where(entry => entry.HabitId == completedHabit.Id)
            .ToList();
        StateHasChanged();
    }

    private async Task ToggleArchiveState()
    {
        if (habit != null)
        {
            if (habit.IsArchived)
            {
                await DbService.RestoreHabitAsync(habit.Id);
            }
            else
            {
                await DbService.ArchiveHabitAsync(habit.Id);
            }

            NavManager.NavigateTo("/app");
        }
    }
}


