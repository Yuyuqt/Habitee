        align-items: center;
        justify-content: center;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem 1.5rem;
    }

    .section-block {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-bottom: 1.6rem;
    }

    .section-block label {
        font-size: var(--font-size-label);
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 1px;
    }

    .segmented-control {
        display: flex;
        gap: 0.3rem;
        padding: 0.3rem;
        border-radius: 18px;
    }

    .segment {
        flex: 1;
