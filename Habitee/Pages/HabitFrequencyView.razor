@page "/habit-frequency"
@using Habitee.Services
@inject HabitDraftService DraftService
@inject NavigationManager NavManager

<div class="view-container slide-in">
    <header class="app-header">
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/new-habit")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <h1 class="header-title">Frequency &amp; Reminders</h1>
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/new-habit")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
    </header>

    <div class="content-scroll">
        <section class="section-block">
            <label>FREQUENCY</label>
            <div class="segmented-control glass-panel">
                @foreach (var option in frequencyOptions)
                {
                    <button type="button" class="segment @(draft.Frequency == option ? "active" : "")" @onclick='() => SetFrequency(option)'>@option</button>
                }
            </div>
        </section>

        @if (draft.Frequency == "Weekly")
        {
            <section class="section-block">
                <label>THIS HABIT SHOULD BE COMPLETED ON @GetWeeklySummary()</label>
                <div class="choice-grid weekly-grid">
                    @foreach (var option in weeklyOptions)
                    {
                        <button type="button" class="choice-cell @(IsWeeklySelected(option) ? "active" : "")" @onclick='() => ToggleWeeklyDay(option)'>@option</button>
                    }
                </div>
            </section>
        }
        else if (draft.Frequency == "Monthly")
        {
            <section class="section-block">
                <label>THIS HABIT SHOULD BE COMPLETED ON @GetMonthlySummary()</label>
                <div class="choice-grid monthly-grid">
                    @for (var day = 1; day <= 31; day++)
                    {
                        var currentDay = day;
                        <button type="button" class="choice-cell @(IsMonthlySelected(currentDay) ? "active" : "")" @onclick='() => ToggleMonthlyDay(currentDay)'>@currentDay</button>
                    }
                </div>
            </section>
        }

        <section class="section-block">
            <label>REMINDERS 0 / 5</label>
            <button type="button" class="reminder-btn glass-panel">
                Add Reminder
            </button>
        </section>

        <div style="height: 110px;"></div>
    </div>
</div>

<style>
    .view-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        max-width: 820px;
        margin: 0 auto;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
    }

    .header-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
        text-align: center;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem 1.5rem;
    }

    .section-block {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-bottom: 1.6rem;
    }

    .section-block label {
        font-size: 0.78rem;
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 1px;
    }

    .segmented-control {
        display: flex;
        gap: 0.3rem;
        padding: 0.3rem;
        border-radius: 18px;
    }

    .segment {
        flex: 1;
        border: none;
        background: transparent;
        color: var(--text-muted);
        padding: 1rem;
        border-radius: 14px;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .segment.active {
        background: var(--primary-color);
        color: white;
        box-shadow: 0 10px 22px color-mix(in srgb, var(--primary-color) 28%, transparent);
    }

    .choice-grid {
        display: grid;
        gap: 0.6rem;
    }

    .weekly-grid {
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .monthly-grid {
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .choice-cell {
        min-height: 66px;
        border-radius: 16px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: color-mix(in srgb, var(--card-bg) 85%, transparent);
        color: var(--text-color);
        font: inherit;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .choice-cell.active {
        background: var(--primary-color);
        color: white;
        border-color: transparent;
    }

    .reminder-btn {
        width: 100%;
        border-radius: 18px;
        padding: 1.1rem;
        border: var(--outline-width, 1px) solid color-mix(in srgb, var(--primary-color) 35%, var(--card-border));
        background: color-mix(in srgb, var(--primary-color) 88%, transparent);
        color: white;
        font: inherit;
        font-size: 1rem;
        font-weight: 700;
        cursor: default;
    }

    @@media (max-width: 720px) {
        .content-scroll {
            padding: 0 1rem 1rem;
        }

        .choice-grid {
            gap: 0.45rem;
        }

        .choice-cell {
            min-height: 54px;
            font-size: 0.92rem;
            border-radius: 14px;
        }
    }
</style>

@code {
    private readonly string[] frequencyOptions = ["Daily", "Weekly", "Monthly"];
    private readonly string[] weeklyOptions = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private Habit draft = new();

    protected override void OnInitialized()
    {
        draft = DraftService.Draft;
    }

    private void SetFrequency(string frequency)
    {
        draft.Frequency = frequency;

        if (frequency == "Weekly" && string.IsNullOrWhiteSpace(draft.WeeklyDaysCsv))
        {
            draft.WeeklyDaysCsv = string.IsNullOrWhiteSpace(draft.WeeklyDay) ? "Mon" : draft.WeeklyDay;
        }

        if (frequency == "Monthly")
        {
            draft.MonthlyDay = Math.Clamp(draft.MonthlyDay, 1, 31);

            if (string.IsNullOrWhiteSpace(draft.MonthlyDaysCsv))
            {
                draft.MonthlyDaysCsv = draft.MonthlyDay.ToString();
            }
        }
    }

    private bool IsWeeklySelected(string day)
    {
        return GetWeeklySelections().Contains(day);
    }

    private void ToggleWeeklyDay(string day)
    {
        var selections = GetWeeklySelections();

        if (selections.Contains(day))
        {
            selections.Remove(day);
        }
        else
        {
            selections.Add(day);
        }

        if (selections.Count == 0)
        {
            selections.Add("Mon");
        }

        draft.WeeklyDaysCsv = string.Join(",", weeklyOptions.Where(selections.Contains));
        draft.WeeklyDay = selections[0];
    }

    private List<string> GetWeeklySelections()
    {
        var selections = draft.WeeklyDaysCsv
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(weeklyOptions.Contains)
            .Distinct()
            .ToList();

        if (selections.Count == 0)
        {
            selections.Add("Mon");
        }

        return selections;
    }

    private bool IsMonthlySelected(int day)
    {
        return GetMonthlySelections().Contains(day);
    }

    private void ToggleMonthlyDay(int day)
    {
        day = Math.Clamp(day, 1, 31);
        var selections = GetMonthlySelections();

        if (selections.Contains(day))
        {
            selections.Remove(day);
        }
        else
        {
            selections.Add(day);
        }

        if (selections.Count == 0)
        {
            selections.Add(1);
        }

        selections = selections
            .Where(value => value >= 1 && value <= 31)
            .Distinct()
            .OrderBy(value => value)
            .ToList();

        draft.MonthlyDaysCsv = string.Join(",", selections);
        draft.MonthlyDay = selections[0];
        StateHasChanged();
    }

    private List<int> GetMonthlySelections()
    {
        var selections = draft.MonthlyDaysCsv
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => int.TryParse(value, out var parsed) ? parsed : -1)
            .Where(value => value >= 1 && value <= 31)
            .Distinct()
            .OrderBy(value => value)
            .ToList();

        if (selections.Count == 0)
        {
            selections.Add(Math.Clamp(draft.MonthlyDay, 1, 31));
        }

        return selections;
    }

    private string GetWeeklySummary()
    {
        return string.Join(", ", GetWeeklySelections()).ToUpperInvariant();
    }

    private string GetMonthlySummary()
    {
        return string.Join(", ", GetMonthlySelections().Select(GetOrdinal));
    }

    private static string GetOrdinal(int number)
    {
        if (number % 100 is 11 or 12 or 13)
        {
            return $"{number}TH";
        }

        return (number % 10) switch
        {
            1 => $"{number}ST",
            2 => $"{number}ND",
            3 => $"{number}RD",
            _ => $"{number}TH"
        };
    }
}
