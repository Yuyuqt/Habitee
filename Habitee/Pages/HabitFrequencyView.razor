        .permission-btn,
        .add-reminder-btn,
        .toggle-pill,
        .remove-reminder-btn {
            width: 100%;
        }
    }
</style>

@code {
    private readonly string[] frequencyOptions = ["Daily", "Weekly", "Monthly"];
    private readonly string[] weeklyOptions = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private Habit draft = new();

    protected override void OnInitialized()
    {
        draft = DraftService.Draft;
        NotificationService.StatusChanged += HandleNotificationStatusChanged;
    }

    public void Dispose()
    {
        NotificationService.StatusChanged -= HandleNotificationStatusChanged;
    }

    private async Task EnableNotifications()
    {
        await NotificationService.EnableNotificationsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void AddReminder()
    {
        if (draft.Reminders.Count >= Habit.MaxReminders)
        {
            return;
        }

        draft.Reminders.Add(new HabitReminder
        {
            Id = GetNextReminderId(),
            TimeLocal = "09:00",
            Enabled = true
        });
    }

    private void RemoveReminder(int reminderId)
    {
        var reminder = draft.Reminders.FirstOrDefault(item => item.Id == reminderId);

        if (reminder != null)
        {
            draft.Reminders.Remove(reminder);
        }
    }

    private void ToggleReminder(HabitReminder reminder)
    {
        reminder.Enabled = !reminder.Enabled;
    }

    private void UpdateReminderTime(HabitReminder reminder, string? timeLocal)
    {
        if (TimeOnly.TryParse(timeLocal, out var parsedTime))
        {
            reminder.TimeLocal = parsedTime.ToString("HH:mm");
        }
    }

    private int GetNextReminderId()
    {
        return draft.Reminders.Count == 0 ? 1 : draft.Reminders.Max(reminder => reminder.Id) + 1;
    }

    private string GetPermissionTitle()
    {
        return NotificationService.Permission switch
        {
            "unsupported" => "Notifications are not supported on this browser.",
            "denied" => "Notifications are blocked.",
            _ when NotificationService.AppNotificationsEnabled => "Reminders are enabled.",
            _ => "Enable notifications for reminders."
        };
    }

    private string GetPermissionDescription()
    {
        return NotificationService.Permission switch
        {
            "unsupported" => "Habitee can still save reminders, but this browser cannot show system notifications.",
            "denied" => "Allow notifications again in your browser settings if you want Habitee to alert you.",
            _ when NotificationService.AppNotificationsEnabled => "Habitee can send best-effort reminders on this device while the app is active or recently resumed.",
            _ => "The browser will only ask after you click the button below."
        };
    }

    private void SetFrequency(string frequency)
    {
        draft.Frequency = frequency;

        if (frequency == "Weekly" && string.IsNullOrWhiteSpace(draft.WeeklyDaysCsv))
        {
            draft.WeeklyDaysCsv = string.IsNullOrWhiteSpace(draft.WeeklyDay) ? "Mon" : draft.WeeklyDay;
        }

        if (frequency == "Monthly")
        {
            draft.MonthlyDay = Math.Clamp(draft.MonthlyDay, 1, 31);

            if (string.IsNullOrWhiteSpace(draft.MonthlyDaysCsv))
            {
                draft.MonthlyDaysCsv = draft.MonthlyDay.ToString();
            }
        }
    }

    private bool IsWeeklySelected(string day)
    {
        return GetWeeklySelections().Contains(day);
    }

    private void ToggleWeeklyDay(string day)
    {
        var selections = GetWeeklySelections();

        if (selections.Contains(day))
        {
            selections.Remove(day);
        }
        else
        {
            selections.Add(day);
        }

        if (selections.Count == 0)
        {
            selections.Add("Mon");
        }

        draft.WeeklyDaysCsv = string.Join(",", weeklyOptions.Where(selections.Contains));
        draft.WeeklyDay = selections[0];
    }

    private List<string> GetWeeklySelections()
    {
        var selections = draft.WeeklyDaysCsv
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(weeklyOptions.Contains)
            .Distinct()
            .ToList();

        if (selections.Count == 0)
        {
            selections.Add("Mon");
        }

        return selections;
    }

    private bool IsMonthlySelected(int day)
    {
        return GetMonthlySelections().Contains(day);
    }

    private void ToggleMonthlyDay(int day)
    {
        day = Math.Clamp(day, 1, 31);
        var selections = GetMonthlySelections();

        if (selections.Contains(day))
        {
            selections.Remove(day);
        }
        else
        {
            selections.Add(day);
        }

        if (selections.Count == 0)
        {
            selections.Add(1);
        }

        selections = selections
            .Where(value => value >= 1 && value <= 31)
            .Distinct()
            .OrderBy(value => value)
            .ToList();

        draft.MonthlyDaysCsv = string.Join(",", selections);
        draft.MonthlyDay = selections[0];
        StateHasChanged();
    }

    private List<int> GetMonthlySelections()
    {
        var selections = draft.MonthlyDaysCsv
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => int.TryParse(value, out var parsed) ? parsed : -1)
            .Where(value => value >= 1 && value <= 31)
            .Distinct()
            .OrderBy(value => value)
            .ToList();

        if (selections.Count == 0)
        {
            selections.Add(Math.Clamp(draft.MonthlyDay, 1, 31));
        }

        return selections;
    }

    private string GetWeeklySummary()
    {
        return string.Join(", ", GetWeeklySelections()).ToUpperInvariant();
    }

    private string GetMonthlySummary()
    {
        return string.Join(", ", GetMonthlySelections().Select(GetOrdinal));
    }

    private static string GetOrdinal(int number)
    {
        if (number % 100 is 11 or 12 or 13)
        {
            return $"{number}TH";
        }

        return (number % 10) switch
        {
            1 => $"{number}ST",
            2 => $"{number}ND",
            3 => $"{number}RD",
            _ => $"{number}TH"
        };
    }

    private void HandleNotificationStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }
}
