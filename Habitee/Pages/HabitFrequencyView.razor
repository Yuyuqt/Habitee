    .choice-grid {
        display: grid;
        gap: 0.6rem;
    }

    .weekly-grid {
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .monthly-grid {
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .choice-cell {
        min-height: 66px;
        border-radius: 16px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: color-mix(in srgb, var(--card-bg) 85%, transparent);
        color: var(--text-color);
        font: inherit;
        font-size: var(--font-size-body);
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .choice-cell.active {
        background: var(--primary-color);
        color: var(--primary-contrast);
        border-color: transparent;
    }

    .choice-cell:hover:not(.active) {
        background: color-mix(in srgb, var(--button-hover-surface) 86%, transparent);
        color: var(--text-color);
        border-color: color-mix(in srgb, var(--primary-color) 24%, var(--button-hover-border));
    }

    .permission-panel,
    .empty-reminder,
    .reminder-row {
        border-radius: 18px;
        padding: 1rem;
    }

    .permission-panel {
