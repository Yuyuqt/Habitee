@page "/habit-frequency"
@using Habitee.Models
@using Habitee.Services
@implements IDisposable
@inject HabitDraftService DraftService
@inject DatabaseService DbService
@inject NavigationManager NavManager
@inject NotificationService NotificationService

<div class="view-container slide-in">
    <header class="app-header">
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/new-habit")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <h1 class="header-title">Frequency &amp; Reminders</h1>
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/new-habit")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </button>
    </header>

    <div class="content-scroll">
        <section class="section-block">
            <label>FREQUENCY</label>
            <div class="segmented-control glass-panel">
                @foreach (var option in frequencyOptions)
                {
                    <button type="button" class="segment @(draft.Frequency == option ? "active" : "")" @onclick='() => SetFrequency(option)'>@option</button>
                }
            </div>
        </section>

        @if (draft.Frequency == "Weekly")
        {
            <section class="section-block">
                <label>THIS HABIT SHOULD BE COMPLETED ON @GetWeeklySummary()</label>
                <div class="choice-grid weekly-grid">
                    @foreach (var option in weeklyOptions)
                    {
                        <button type="button" class="choice-cell @(IsWeeklySelected(option) ? "active" : "")" @onclick='() => ToggleWeeklyDay(option)'>@option</button>
                    }
                </div>
            </section>
        }
        else if (draft.Frequency == "Monthly")
        {
            <section class="section-block">
                <label>THIS HABIT SHOULD BE COMPLETED ON @GetMonthlySummary()</label>
                
                <div class="calendar-picker glass-panel">
                    <div class="calendar-picker-header">
                        <h3 class="month-title">@referenceDate.ToString("MMMM yyyy")</h3>
                    </div>

                    <div class="calendar-weekdays">
                        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                    </div>

                    <div class="choice-grid monthly-grid">
                        @{
                            var firstDayOfMonth = new DateTime(referenceDate.Year, referenceDate.Month, 1);
                            var daysInMonth = DateTime.DaysInMonth(referenceDate.Year, referenceDate.Month);
                            var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
                            if (startDayOfWeek == 0) startDayOfWeek = 7;

                            for (int i = 1; i < startDayOfWeek; i++)
                            {
                                <div class="choice-cell empty"></div>
                            }

                            for (int day = 1; day <= daysInMonth; day++)
                            {
                                var currentDay = day;
                                <button type="button" 
                                        class="choice-cell @(IsMonthlySelected(currentDay) ? "active" : "") @(IsPastDay(currentDay) ? "locked" : "") @(IsPastDayCompleted(currentDay) ? "completed" : "")" 
                                        disabled="@IsPastDay(currentDay)"
                                        style="--habit-color: @draft.Color;"
                                        @onclick='() => ToggleMonthlyDay(currentDay)'>
                                    <span class="day-label">@currentDay</span>
                                    @if (IsPastDay(currentDay))
                                    {
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lock-icon">
                                            <rect x="3" y="10" width="18" height="11" rx="2" ry="2"></rect>
                                            <path d="M7 10V7a5 5 0 0 1 10 0v3"></path>
                                        </svg>
                                    }
                                </button>
                            }
                        }
                    </div>
                </div>
            </section>
        }

        <section class="section-block">
            <div class="reminders-header">
                <label>REMINDERS @draft.Reminders.Count / @Habit.MaxReminders</label>
                <button type="button"
                        class="add-reminder-btn glass-button"
                        disabled="@(draft.Reminders.Count >= Habit.MaxReminders)"
                        @onclick="AddReminder">
                    Add Reminder
                </button>
            </div>

            @if (draft.Reminders.Count == 0)
            {
                <div class="empty-reminder glass-panel">
                    <p>No reminders yet. Add up to five daily reminder times for this habit.</p>
                </div>
            }
            else
            {
                <div class="reminder-list">
                    @foreach (var reminder in draft.Reminders.OrderBy(reminder => reminder.TimeLocal))
                    {
                        <div class="reminder-row glass-panel">
                            <button type="button"
                                    class="glass-input reminder-time reminder-time-picker-button"
                                    @onclick="() => OpenTimePicker(reminder)">
                                @GetDisplayTime(reminder)
                            </button>

                            <button type="button"
                                    class="toggle-pill @(reminder.Enabled ? "enabled" : "disabled")"
                                    @onclick="() => ToggleReminder(reminder)">
                                @(reminder.Enabled ? "On" : "Off")
                            </button>

                            <button type="button" class="remove-reminder-btn" @onclick="() => RemoveReminder(reminder.Id)">
                                Remove
                            </button>
                        </div>
                    }
                </div>
            }
        </section>

        <div style="height: 110px;"></div>
    </div>
</div>

@if (selectedReminderId is not null && GetReminderById(selectedReminderId.Value) is { } editingReminder)
{
    <div class="time-picker-backdrop" @onclick="CloseTimePicker">
        <div class="time-picker-modal glass-panel" @onclick:stopPropagation="true">
            <h3>Reminder Time</h3>

            <div class="time-picker-wheel-grid">
                <div class="time-picker-wheel-column">
                    <label>Hour</label>
                    <select class="time-wheel" size="6" @bind="selectedHour">
                        @foreach (var hour in hourOptions)
                        {
                            <option value="@hour">@hour</option>
                        }
                    </select>
                </div>

                <div class="time-picker-wheel-column">
                    <label>Minute</label>
                    <select class="time-wheel" size="6" @bind="selectedMinute">
                        @foreach (var minute in minuteOptions)
                        {
                            <option value="@minute">@minute</option>
                        }
                    </select>
                </div>

                <div class="time-picker-wheel-column">
                    <label>AM / PM</label>
                    <select class="time-wheel" size="2" @bind="selectedPeriod">
                        <option>AM</option>
                        <option>PM</option>
                    </select>
                </div>
            </div>

            <div class="time-picker-actions">
                <button type="button" class="time-picker-action-btn" @onclick="CloseTimePicker">Cancel</button>
                <button type="button" class="time-picker-action-btn save" @onclick="() => ApplyTimePickerSelection(editingReminder)">Set Time</button>
            </div>
        </div>
    </div>
}

@if (showNotificationsPrompt)
{
    <div class="modal-backdrop" @onclick="CloseNotificationPrompt">
        <div class="notification-modal glass-panel" @onclick:stopPropagation="true">
            <h3>Turn on notifications</h3>
            <p>Enable reminders in Settings first, then come back to add reminder times.</p>
            <div class="notification-modal-actions">
                <button type="button" class="modal-btn" @onclick="CloseNotificationPrompt">Not now</button>
                <button type="button" class="modal-btn modal-primary" @onclick="GoToNotificationSettings">
                    Open Settings
                </button>
            </div>
        </div>
    </div>
}

<style>
