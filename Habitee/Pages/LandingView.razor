@page "/"
@layout Habitee.Layout.PublicLayout
@using Habitee.Components
@using Habitee.Models
@inject NavigationManager NavManager

<PageTitle>Habitee - The Local-First Habit Tracker</PageTitle>

<div class="landing-container fade-in">
    <!-- Hero Section -->
    <div class="hero-section">
        <h1 class="hero-title">
            Your habits, <br/>
            <span class="text-gradient">beautifully tracked.</span>
        </h1>
        <p class="hero-subtitle">
            A minimalist, local-first habit tracker that respects your privacy. 
            No ads, no tracking, just you and your goals.
        </p>
        
        <div class="cta-group">
            <button class="primary-btn" @onclick='() => NavManager.NavigateTo("/signup")'>
                Start Tracking Free
            </button>
            <button class="secondary-btn glass-button" @onclick='() => NavManager.NavigateTo("/login")'>
                Log In
            </button>
        </div>
    </div>

    <!-- Showcase Section (Live Preview) -->
    <div class="showcase-section">
        <div class="app-frame glass-panel card-hover-lift">
            <div class="frame-header">
                <div class="traffic-lights">
                    <span></span><span></span><span></span>
                </div>
                <div class="frame-title">Daily Focus</div>
                <div class="frame-header-spacer" aria-hidden="true"></div>
            </div>
            
            <div class="frame-content">
                <div class="habits-list">
                    @foreach (var habit in mockHabits)
                    {
                        <HabitCard Habit="habit" Logs="mockLogs" DisableNavigation="true" MonthsToShow="2" />
                    }
                </div>

                <div class="graph-showcase glass-panel">
                    <h3 class="graph-title">Activity Overview</h3>
                    <MonthlyContributionGraph Logs="mockLogs" TargetCount="1" Color="#3B82F6" Compact="false" MonthsToShow="2" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .landing-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
        min-height: 100vh;
    }

    .hero-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        z-index: 2;
    }

    .hero-title {
        font-size: 4rem;
        font-weight: 800;
        line-height: 1.1;
        margin: 0;
        color: var(--text-color);
        letter-spacing: -0.02em;
    }

    .text-gradient {
        background: linear-gradient(to right, var(--primary-color), #8B5CF6);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: var(--text-muted);
        line-height: 1.6;
        max-width: 480px;
        margin: 0;
    }

    .cta-group {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    .primary-btn {
        background-color: var(--primary-color);
        color: white;
        border: none;
        padding: 0.875rem 1.5rem;
        border-radius: 9999px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4);
    }

    .primary-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(59, 130, 246, 0.6);
    }

    .secondary-btn {
        padding: 0.875rem 1.5rem;
        border-radius: 9999px;
        font-size: 1.1rem;
        font-weight: 600;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    /* App Frame (Showcase) */
    .showcase-section {
        perspective: 1000px;
        z-index: 2;
    }

    .app-frame {
        border-radius: 24px;
        overflow: hidden;
        background: var(--card-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--card-border);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        transform: rotateY(-5deg) rotateX(5deg);
        transition: transform 0.3s ease;
        padding: 0.5rem; /* slight horizontal padding around inner frame */
    }

    .app-frame:hover {
        transform: rotateY(0) rotateX(0);
    }

    .frame-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        column-gap: 0.75rem;
        padding: 1rem 1.5rem;
        background: color-mix(in srgb, var(--card-bg) 80%, white 5%);
        border-bottom: 1px solid var(--card-border);
    }

    .traffic-lights {
        display: flex;
        gap: 6px;
    }

    .traffic-lights span {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #E2E8F0;
    }

    .traffic-lights span:nth-child(1) { background-color: #FF5F56; }
    .traffic-lights span:nth-child(2) { background-color: #FFBD2E; }
    .traffic-lights span:nth-child(3) { background-color: #27C93F; }

    .frame-header-spacer {
        width: 48px;
    }

    .frame-title {
        text-align: center;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-muted);
        min-width: 0;
    }

    .frame-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .habits-list {
        display: flex;
        flex-direction: column;
    }

    .graph-showcase {
        padding: 1.5rem;
        border-radius: 16px;
        background: color-mix(in srgb, var(--card-bg) 90%, white 2%);
    }

    .graph-title {
        font-size: 1.1rem;
        margin: 0 0 1rem 0;
        font-weight: 600;
        color: var(--text-color);
    }

    @@media (max-width: 968px) {
        .landing-container {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 3rem 1rem;
            gap: 3rem;
        }

        .hero-title {
            font-size: 3rem;
        }

        .hero-subtitle {
            margin: 0 auto;
        }

        .cta-group {
            justify-content: center;
        }

        .app-frame {
            transform: none;
        }
    }
</style>

@code {
    private List<Habit> mockHabits = new();
    private List<HabitLog> mockLogs = new();

    protected override void OnInitialized()
    {
        GenerateMockData();
    }

    private void GenerateMockData()
    {
        mockHabits = new List<Habit>
        {
            new Habit { Id = "1", Title = "Read 20 pages", Description = "Daily reading habit", Color = "#3B82F6", Icon = "book", TargetCount = 1 },
            new Habit { Id = "2", Title = "Morning Workout", Description = "Stay fit and healthy", Color = "#10B981", Icon = "dumbbell", TargetCount = 1 },
            new Habit { Id = "3", Title = "Meditation", Description = "10 minutes of mindfulness", Color = "#8B5CF6", Icon = "sparkles", TargetCount = 1 }
        };

        var today = DateTime.Today;
        
        // Generate random logs for the past 60 days
        var random = new Random(42); // Fixed seed for consistent preview
        for (int i = 0; i < 60; i++)
        {
            var date = today.AddDays(-i);
            var dateStr = date.ToString("yyyy-MM-dd");

            // Habit 1: ~80% completion
            if (random.NextDouble() > 0.2)
                mockLogs.Add(new HabitLog { HabitId = "1", Date = dateStr, CompletedCount = 1 });

            // Habit 2: ~60% completion
            if (random.NextDouble() > 0.4)
                mockLogs.Add(new HabitLog { HabitId = "2", Date = dateStr, CompletedCount = 1 });

            // Habit 3: ~40% completion
            if (random.NextDouble() > 0.6)
                mockLogs.Add(new HabitLog { HabitId = "3", Date = dateStr, CompletedCount = 1 });
        }
    }
}
