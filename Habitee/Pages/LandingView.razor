@page "/"
@layout Habitee.Layout.PublicLayout
@using Habitee.Components
@using Habitee.Models
@inject NavigationManager NavManager

<PageTitle>Habitee - The Local-First Habit Tracker</PageTitle>

<div class="landing-container fade-in">
    <!-- Hero Section -->
    <div class="hero-section">
        <h1 class="hero-title">
            Your habits, <br/>
            <span class="text-accent">beautifully tracked.</span>
        </h1>
        <p class="hero-subtitle">
            A minimalist, local-first habit tracker that respects your privacy. 
            No ads, no tracking, just you and your goals.
        </p>
        
        <div class="cta-group">
            <button class="primary-btn" @onclick='() => NavManager.NavigateTo("/signup")'>
                Start Tracking Free
            </button>
            <button class="secondary-btn glass-button landing-login-btn" @onclick='() => NavManager.NavigateTo("/login")'>
                Log In
            </button>
        </div>
    </div>

    <!-- Showcase Section (Live Preview) -->
    <div class="showcase-section">
        <div class="app-frame glass-panel">
            <div class="frame-header">
                <div class="traffic-lights">
                    <span></span><span></span><span></span>
                </div>
                <div class="frame-title">Daily Focus</div>
                <div class="frame-header-spacer" aria-hidden="true"></div>
            </div>
            
            <div class="frame-content">
                <div class="habits-list">
                    @foreach (var habit in mockHabits)
                    {
                        <HabitCard Habit="habit" Logs="mockLogs" DisableNavigation="true" MonthsToShow="2" />
                    }
                </div>

                <div class="graph-showcase glass-panel">
                    <h3 class="graph-title">Activity Overview</h3>
                    <MonthlyContributionGraph Logs="mockLogs" TargetCount="1" Color="#3B82F6" Compact="false" MonthsToShow="2" />
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .landing-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4.75rem 1.5rem 1.75rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
        min-height: auto;
    }

    .hero-section {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        z-index: 2;
        padding-top: 3.4rem;
    }

    .hero-title {
        font-size: 4.5rem;
        font-weight: 800;
        line-height: 1;
        margin: 0;
        color: var(--text-color);
        letter-spacing: -0.04em;
    }

    .text-accent {
        color: var(--primary-color);
    }

    .hero-subtitle {
        font-size: 1.25rem;
        color: var(--text-muted);
        line-height: 1.6;
        max-width: 480px;
        margin: 0;
    }

    .cta-group {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }

    .primary-btn {
        background-color: var(--primary-color);
        color: var(--primary-contrast);
        border: none;
        padding: 1rem 2rem;
        border-radius: 20px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 10px 20px rgba(37, 99, 235, 0.15);
    }

    .primary-btn:hover {
        background: color-mix(in srgb, var(--primary-color) 92%, black 8%);
    }

    .secondary-btn {
        padding: 0.875rem 1.5rem;
        border-radius: 14px;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .landing-login-btn:hover {
        background: var(--card-bg);
        border-color: var(--card-border);
        color: var(--text-color);
        transform: translateY(-2px);
        box-shadow: var(--card-shadow);
    }

    /* App Frame (Showcase) */
    .showcase-section {
        z-index: 2;
    }

    .app-frame {
        border-radius: 32px;
        overflow: hidden;
        background: var(--card-bg);
        border: 2px solid var(--card-border);
        box-shadow: var(--card-shadow-strong);
        padding: 0.5rem;
    }

    .frame-header {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        column-gap: 0.75rem;
        padding: 1rem 1.5rem;
        background: color-mix(in srgb, var(--card-bg) 80%, white 5%);
        border-bottom: 1px solid var(--card-border);
    }

    .traffic-lights {
        display: flex;
        gap: 6px;
    }

    .traffic-lights span {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background-color: #E2E8F0;
    }

    .traffic-lights span:nth-child(1) { background-color: #FF5F56; }
    .traffic-lights span:nth-child(2) { background-color: #FFBD2E; }
    .traffic-lights span:nth-child(3) { background-color: #27C93F; }

    .frame-header-spacer {
        width: 48px;
    }

    .frame-title {
        text-align: center;
        font-weight: 600;
        font-size: 0.9rem;
        color: var(--text-muted);
        min-width: 0;
    }

    .frame-content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .habits-list {
        display: flex;
        flex-direction: column;
    }

    .graph-showcase {
        padding: 1.5rem;
        border-radius: var(--border-radius);
        background: var(--card-bg);
    }

    .graph-title {
        font-size: 1.1rem;
        margin: 0 0 1rem 0;
        font-weight: 600;
        color: var(--text-color);
    }

    @@media (max-width: 968px) {
        .landing-container {
            grid-template-columns: 1fr;
            text-align: center;
            padding: 4.45rem 1rem 1.5rem;
            gap: 2rem;
            min-height: auto;
        }

        .hero-section {
            align-items: center;
        }

        .hero-title {
            font-size: 3rem;
            width: 100%;
            max-width: 10ch;
            margin: 0 auto;
            text-align: center;
        }

        .hero-subtitle {
            width: 100%;
            margin: 0 auto;
            text-align: center;
        }

        .cta-group {
            justify-content: center;
            width: 100%;
        }
    }

    @@media (max-width: 720px) {
        .landing-container {
            padding: 4.2rem 1rem 1.2rem;
            gap: 1.5rem;
        }

        .hero-section {
            gap: 1rem;
        }

        .hero-title {
            font-size: clamp(1.75rem, 8vw, 2.4rem);
            line-height: 1.08;
            max-width: 12ch;
        }

        .hero-subtitle {
            font-size: var(--font-size-body);
            line-height: 1.6;
            max-width: 34ch;
        }

        .cta-group {
            flex-direction: column;
            align-items: stretch;
            gap: 0.75rem;
        }

        .primary-btn,
        .secondary-btn {
            width: 100%;
            padding: 0.95rem 1rem;
            font-size: var(--font-size-body);
        }

        .app-frame {
            border-radius: 24px;
            padding: 0.35rem;
        }

        .frame-header {
            padding: 0.85rem 1rem;
        }

        .frame-content,
        .graph-showcase {
            padding: 1rem;
        }
    }

    @@media (max-width: 540px) {
        .landing-container {
            padding: 4rem 1rem 1rem;
        }

        .hero-title {
            font-size: clamp(1.6rem, 9vw, 2rem);
        }

        .traffic-lights span {
            width: 10px;
            height: 10px;
        }

        .frame-title {
            font-size: 0.8rem;
        }
    }
</style>

@code {
    private List<Habit> mockHabits = new();
    private List<HabitLog> mockLogs = new();

    protected override void OnInitialized()
    {
        GenerateMockData();
    }

    private void GenerateMockData()
    {
        mockHabits = new List<Habit>
        {
            new Habit { Id = "1", Title = "Read 20 pages", Description = "Daily reading habit", Color = "#3B82F6", Icon = "book", TargetCount = 1 },
            new Habit { Id = "2", Title = "Morning Workout", Description = "Stay fit and healthy", Color = "#10B981", Icon = "dumbbell", TargetCount = 1 },
            new Habit { Id = "3", Title = "Meditation", Description = "10 minutes of mindfulness", Color = "#8B5CF6", Icon = "sparkles", TargetCount = 1 }
        };

        var today = DateTime.Today;
        
        // Generate random logs for the past 60 days
        var random = new Random(42); // Fixed seed for consistent preview
        for (int i = 0; i < 60; i++)
        {
            var date = today.AddDays(-i);
            var dateStr = date.ToString("yyyy-MM-dd");

            // Habit 1: ~80% completion
            if (random.NextDouble() > 0.2)
                mockLogs.Add(new HabitLog { HabitId = "1", Date = dateStr, CompletedCount = 1 });

            // Habit 2: ~60% completion
            if (random.NextDouble() > 0.4)
                mockLogs.Add(new HabitLog { HabitId = "2", Date = dateStr, CompletedCount = 1 });

            // Habit 3: ~40% completion
            if (random.NextDouble() > 0.6)
                mockLogs.Add(new HabitLog { HabitId = "3", Date = dateStr, CompletedCount = 1 });
        }
    }
}
