@page "/app"
@using Habitee.Models
@using Habitee.Services
@inject DatabaseService DbService
@inject NavigationManager NavManager

<div class="container">
    <header class="view-header">
        <div>
            <h1 class="view-title">Daily Focus</h1>
            <p class="view-subtitle">@DateTime.Today.ToString("dddd, MMMM d")</p>
        </div>
        <button class="glass-button primary-btn" @onclick='() => NavManager.NavigateTo("/add-habit")'>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Habit
        </button>
    </header>

    @if (isLoading)
    {
        <div class="flex-center" style="height: 200px;">
            <p>Loading habits...</p>
        </div>
    }
    else if (!habits.Any())
    {
        <Habitee.Components.RedirectTo Url="/add-habit" />
    }
    else
    {
        <div class="habits-list">
            @foreach (var habit in VisibleHabits)
            {
                var habitLogs = logs.Where(l => l.HabitId == habit.Id).ToList();
                <HabitCard Habit="habit" Logs="habitLogs" OnComplete="HandleComplete" />
            }
        </div>

        @if (TotalPages > 1)
        {
            <div class="pager-row">
                <button type="button"
                        class="glass-button pager-btn"
                        disabled="@(CurrentPage == 1)"
                        @onclick="PreviousPage">
                    Previous
                </button>
                <div class="pager-meta">
                    <span>Page @CurrentPage of @TotalPages</span>
                    <small>@PageSummary</small>
                </div>
                <button type="button"
                        class="glass-button pager-btn"
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="NextPage">
                    Next
                </button>
            </div>
        }
    }
</div>

<style>
    .view-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .view-title {
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
        margin: 0;
        color: var(--text-color);
    }

    .view-subtitle {
        font-size: var(--font-size-body);
        margin-top: 0.35rem;
        color: var(--text-muted);
    }

    .habits-list {
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        padding: 3rem;
        text-align: center;
        margin-top: 2rem;
    }

    @@media (max-width: 720px) {
        .view-header {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
            margin-bottom: 1.5rem;
            padding-top: 1.5rem;
        }
    }

    @@media (max-width: 540px) {
        .view-header {
            gap: 0.85rem;
        }

        .view-subtitle {
            margin-top: 0.25rem;
        }
    }
</style>

@code {
    private const int PageSize = 6;
    private List<Habit> habits = new();
    private List<HabitLog> logs = new();
    private bool isLoading = true;
    private int currentPage = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(habits.Count / (double)PageSize));
    private int CurrentPage => Math.Min(currentPage, TotalPages);
    private IEnumerable<Habit> VisibleHabits => habits
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);
    private string PageSummary
    {
        get
        {
            if (!habits.Any())
            {
                return "0 habits";
            }

            var start = ((CurrentPage - 1) * PageSize) + 1;
            var end = Math.Min(CurrentPage * PageSize, habits.Count);
            return $"{start}-{end} of {habits.Count} habits";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        
        habits = await DbService.GetActiveHabitsAsync();

        if (!habits.Any())
        {
            logs = new();
            isLoading = false;
            StateHasChanged();
            return;
        }

        logs = await DbService.GetLogsAsync();
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleComplete(Habit habit)
    {
        await DbService.CycleHabitCompletionAsync(habit);
        logs = await DbService.GetLogsAsync();
        StateHasChanged();
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            currentPage++;
        }
    }
}
