@page "/app"
@using Habitee.Models
@using Habitee.Services
@inject DatabaseService DbService
@inject NavigationManager NavManager

<div class="container">
    <header class="view-header">
        <div>
            <h1 class="view-title">Daily Focus</h1>
            <p class="view-subtitle">@DateTime.Today.ToString("dddd, MMMM d")</p>
        </div>
        <button class="glass-button" @onclick='() => NavManager.NavigateTo("/add-habit")'>
            + New
        </button>
    </header>

    @if (isLoading)
    {
        <div class="flex-center" style="height: 200px;">
            <p>Loading habits...</p>
        </div>
    }
    else if (!habits.Any())
    {
        <Habitee.Components.RedirectTo Url="/add-habit" />
    }
    else
    {
        <div class="habits-list">
            @foreach (var habit in habits)
            {
                var habitLogs = logs.Where(l => l.HabitId == habit.Id).ToList();
                <HabitCard Habit="habit" Logs="habitLogs" OnComplete="HandleComplete" />
            }
        </div>
    }
</div>

<style>
    .view-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .view-title {
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
        margin: 0;
        color: var(--text-color);
    }

    .view-subtitle {
        font-size: var(--font-size-body);
        margin-top: 0.35rem;
        color: var(--text-muted);
    }

    .habits-list {
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        padding: 3rem;
        text-align: center;
        margin-top: 2rem;
    }
</style>

@code {
    private List<Habit> habits = new();
    private List<HabitLog> logs = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        
        habits = await DbService.GetActiveHabitsAsync();

        if (!habits.Any())
        {
            logs = new();
            isLoading = false;
            StateHasChanged();
            return;
        }

        logs = await DbService.GetLogsAsync();
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleComplete(Habit habit)
    {
        await DbService.CycleHabitCompletionAsync(habit);
        logs = await DbService.GetLogsAsync();
        StateHasChanged();
    }
}
