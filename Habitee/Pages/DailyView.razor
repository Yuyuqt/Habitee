@page "/"
@using Habitee.Models
@using Habitee.Services
@inject DatabaseService DbService

<div class="container">
    <header class="view-header">
        <div>
            <h1 class="view-title">Daily Focus</h1>
            <p class="view-subtitle">@DateTime.Today.ToString("dddd, MMMM d")</p>
        </div>
        <button class="glass-button" @onclick="CreateDemoHabit">
            + New
        </button>
    </header>

    @if (isLoading)
    {
        <div class="flex-center" style="height: 200px;">
            <p>Loading habits...</p>
        </div>
    }
    else if (!habits.Any())
    {
        <div class="empty-state glass-panel">
            <h2>No habits yet</h2>
            <p>Start your journey by adding a new habit.</p>
        </div>
    }
    else
    {
        <div class="habits-list">
            @foreach (var habit in habits)
            {
                var habitLogs = logs.Where(l => l.HabitId == habit.Id).ToList();
                <HabitCard Habit="habit" Logs="habitLogs" OnComplete="HandleComplete" />
            }
        </div>
    }
</div>

<style>
    .view-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .view-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0;
        background: linear-gradient(to right, var(--text-color), var(--primary-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .view-subtitle {
        font-size: 1.1rem;
        margin-top: 0.25rem;
    }

    .habits-list {
        display: flex;
        flex-direction: column;
    }

    .empty-state {
        padding: 3rem;
        text-align: center;
        margin-top: 2rem;
    }
</style>

@code {
    private List<Habit> habits = new();
    private List<HabitLog> logs = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        // Wait briefly to ensure DB is initialized (handled in MainLayout, but just in case)
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();
        
        habits = await DbService.GetAllHabitsAsync();
        logs = await DbService.GetLogsAsync();
        
        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleComplete(Habit habit)
    {
        var todayStr = DateTime.Today.ToString("yyyy-MM-dd");
        var log = logs.FirstOrDefault(l => l.HabitId == habit.Id && l.Date == todayStr);
        
        if (log == null)
        {
            log = new HabitLog
            {
                HabitId = habit.Id,
                Date = todayStr,
                CompletedCount = 1
            };
            logs.Add(log);
        }
        else
        {
            log.CompletedCount++;
        }

        await DbService.SaveLogAsync(log);
        // We don't necessarily need to reload all data, just statehaschanged to re-render UI
        StateHasChanged();
    }

    private async Task CreateDemoHabit()
    {
        var newHabit = new Habit
        {
            Title = "Read 10 Pages",
            Description = "Self improvement reading",
            Color = "var(--primary-color)",
            Icon = "book"
        };
        await DbService.SaveHabitAsync(newHabit);
        await LoadData();
    }
}
