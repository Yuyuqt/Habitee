@page "/grid"
@using Habitee.Components
@using Habitee.Models
@using Habitee.Services
@inject DatabaseService DbService
@inject NavigationManager NavManager

<div class="grid-view fade-in">
    <header class="grid-header">
        <div>
            <h1 class="grid-title">All Habits</h1>
            <p class="grid-subtitle">Monthly contribution snapshots</p>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="flex-center loading-state">
            <div class="loading-spinner"></div>
        </div>
    }
    else if (!habits.Any())
    {
        <Habitee.Components.RedirectTo Url="/add-habit" />
    }
    else
    {
        <div class="habit-card-grid">
            @foreach (var habit in VisibleHabits)
            {
                var habitLogs = logs.Where(log => log.HabitId == habit.Id).ToList();
                var todayProgress = GetTodayProgress(habit, habitLogs);

                <div class="grid-habit-card glass-panel"
                     @onclick='() => NavManager.NavigateTo($"/habit/{habit.Id}")'>
                    <div class="grid-card-top">
                        <div class="grid-habit-copy">
                            <div class="grid-icon-ring" style="@($"--habit-color: {habit.Color};")">
                                <HabitIcon Name="@habit.Icon" Color="@habit.Color" Size="24" />
                            </div>
                            <div class="grid-copy-text">
                                <h3>@habit.Title</h3>
                                @if (!string.IsNullOrWhiteSpace(habit.Description))
                                {
                                    <p>@habit.Description</p>
                                }
                            </div>
                        </div>

                        <button type="button"
                                class="grid-status-badge @todayProgress.CssClass"
                                style="@($"--habit-color: {habit.Color};")"
                                title="Update today's progress"
                                @onclick="() => HandleComplete(habit)"
                                @onclick:stopPropagation="true">
                            @if (todayProgress.IsComplete)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            }
                            else
                            {
                                <span>@todayProgress.Label</span>
                            }
                        </button>
                    </div>

                    <div class="grid-contribution-wrap">
                        <MonthlyContributionGraph Logs="habitLogs"
                                                  TargetCount="habit.TargetCount"
                                                  Color="@habit.Color"
                                                  Compact="true"
                                                  MonthsToShow="1"
                                                  ShowMonthLabel="false" />
                    </div>
                </div>
            }

            <button class="grid-habit-card add-habit-card glass-panel"
                    @onclick='() => NavManager.NavigateTo("/add-habit")'>
                <div class="add-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" x2="12" y1="5" y2="19"></line>
                        <line x1="5" x2="19" y1="12" y2="12"></line>
                    </svg>
                </div>
                <div class="add-copy">
                    <h3>New Habit</h3>
                    <p>Create another habit card for your grid.</p>
                </div>
            </button>
        </div>

        @if (TotalPages > 1)
        {
            <div class="pager-row">
                <button type="button"
                        class="glass-button pager-btn"
                        disabled="@(CurrentPage == 1)"
                        @onclick="PreviousPage">
                    Previous
                </button>
                <div class="pager-meta">
                    <span>Page @CurrentPage of @TotalPages</span>
                    <small>@PageSummary</small>
                </div>
                <button type="button"
                        class="glass-button pager-btn"
                        disabled="@(CurrentPage == TotalPages)"
                        @onclick="NextPage">
                    Next
                </button>
            </div>
        }
    }
</div>

<style>
    .grid-view {
        padding: 2.5rem 1.5rem 1.5rem;
        max-width: 1120px;
        margin: 0 auto;
    }

    .grid-header {
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .grid-title {
        margin: 0;
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
    }

    .grid-subtitle {
        margin: 0.35rem 0 0;
        color: var(--text-muted);
        font-size: var(--font-size-body);
    }

    .loading-state {
        height: 220px;
    }

    .grid-empty {
        padding: 2rem;
        text-align: center;
    }

    .habit-card-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        width: 100%;
    }

    .grid-habit-card {
        flex: 1 1 calc(25% - 0.8rem);
        min-width: 220px;
        max-width: 100%;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        text-align: left;
        padding: 0.8rem;
        border-radius: 20px;
        cursor: pointer;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        min-height: 190px;
        box-shadow: var(--card-shadow);
        position: relative;
        overflow: hidden;
    }

    .grid-card-top {
        display: flex;
        justify-content: space-between;
        gap: 0.55rem;
        align-items: flex-start;
    }

    .grid-habit-copy {
        display: flex;
        gap: 0.6rem;
        min-width: 0;
        align-items: flex-start;
    }

    .grid-icon-ring {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--habit-color) 45%, var(--card-border));
        display: flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--habit-color) 12%, transparent);
        flex-shrink: 0;
    }

    .grid-copy-text {
        min-width: 0;
    }

    .grid-copy-text h3 {
        font-size: var(--font-size-card-title);
        line-height: 1.2;
        margin: 0;
        word-break: break-word;
    }

    .grid-copy-text p {
        margin: 0.2rem 0 0;
        font-size: var(--font-size-micro);
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .grid-status-badge {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--habit-color) 40%, var(--card-border));
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--font-size-micro);
        font-weight: 700;
        flex-shrink: 0;
        color: var(--text-color);
        background: rgba(255, 255, 255, 0.18);
        padding: 0;
        cursor: pointer;
        font: inherit;
        transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .grid-status-badge:hover {
        background: color-mix(in srgb, var(--button-hover-surface) 86%, transparent);
        border-color: color-mix(in srgb, var(--habit-color) 52%, var(--button-hover-border));
        color: var(--text-color);
    }

    .grid-status-badge.complete {
        background: color-mix(in srgb, var(--habit-color) 84%, white 16%);
        color: var(--primary-contrast);
        border-color: transparent;
    }

    .grid-status-badge.complete:hover {
        background: color-mix(in srgb, var(--habit-color) 84%, white 16%);
        color: var(--primary-contrast);
        border-color: transparent;
    }

    .grid-status-badge.partial {
        color: var(--habit-color);
    }

    .grid-status-badge.empty {
        color: var(--text-muted);
    }

    .grid-contribution-wrap {
        padding: 0.1rem 0 0;
    }

    .add-habit-card {
        justify-content: center;
        align-items: flex-start;
        border-style: dashed;
        background: transparent;
    }

    .add-icon {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.1);
        color: var(--primary-color);
    }

    .add-copy h3 {
        margin: 0.55rem 0 0;
        font-size: var(--font-size-body);
    }

    .add-copy p {
        margin: 0.25rem 0 0;
        font-size: var(--font-size-micro);
    }

    @("@media") (max-width: 640px) {
        .grid-view {
            padding: 1.5rem 1rem 1rem;
        }

        .grid-habit-card {
            min-height: 176px;
            padding: 0.75rem;
            border-radius: 18px;
        }

        .grid-copy-text h3 {
            font-size: var(--font-size-body-sm);
        }

        .grid-status-badge {
            width: 38px;
            height: 38px;
            font-size: 0.62rem;
        }

        .grid-icon-ring {
            width: 38px;
            height: 38px;
        }
    }

    @("@media") (max-width: 540px) {
        .grid-header {
            margin-bottom: 1.35rem;
            padding-top: 1.5rem;
        }

        .grid-card-top {
            gap: 0.7rem;
        }

        .grid-copy-text p {
            -webkit-line-clamp: 4;
            white-space: normal;
        }
    }
</style>

@code {
    private readonly record struct HabitProgressState(string Label, string CssClass, bool IsComplete);
    private const int PageSize = 8;

    private List<Habit> habits = new();
    private List<HabitLog> logs = new();
    private bool isLoading = true;
    private int currentPage = 1;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(habits.Count / (double)PageSize));
    private int CurrentPage => Math.Min(currentPage, TotalPages);
    private IEnumerable<Habit> VisibleHabits => habits
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize);
    private string PageSummary
    {
        get
        {
            if (!habits.Any())
            {
                return "0 habits";
            }

            var start = ((CurrentPage - 1) * PageSize) + 1;
            var end = Math.Min(CurrentPage * PageSize, habits.Count);
            return $"{start}-{end} of {habits.Count} habits";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        habits = await DbService.GetActiveHabitsAsync();

        if (!habits.Any())
        {
            logs = new();
            isLoading = false;
            return;
        }

        logs = await DbService.GetLogsAsync();
        isLoading = false;
    }

    private async Task HandleComplete(Habit habit)
    {
        await DbService.CycleHabitCompletionAsync(habit);
        logs = await DbService.GetLogsAsync();
        StateHasChanged();
    }

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private static HabitProgressState GetTodayProgress(Habit habit, List<HabitLog> habitLogs)
    {
        var todayKey = DateTime.Today.ToString("yyyy-MM-dd");
        var completedCount = DatabaseService.NormalizeCompletedCount(
            habitLogs.FirstOrDefault(log => log.Date == todayKey)?.CompletedCount ?? 0,
            habit.TargetCount);

        if (DatabaseService.IsCompleteForTarget(completedCount, habit.TargetCount))
        {
            return new HabitProgressState($"{completedCount}/{habit.TargetCount}", "complete", true);
        }

        if (completedCount > 0)
        {
            return new HabitProgressState($"{completedCount}/{habit.TargetCount}", "partial", false);
        }

        return new HabitProgressState($"0/{habit.TargetCount}", "empty", false);
    }
}


