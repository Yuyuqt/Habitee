        --theme-preview: #3b82f6;
        --theme-surface: #0f172a;
        --theme-ink: #f1f5f9;
        --theme-accent: #60a5fa;
        --palette-1: #1d4ed8;
        --palette-2: #3b82f6;
        --palette-3: #60a5fa;
        --palette-4: #1e293b;
        --palette-5: #0f172a;
    }

    .theme-btn.pastel {
        --theme-preview: #8690a2;
        --theme-surface: #e0decd;
        --theme-ink: #62574d;
        --theme-accent: #d2c296;
        --palette-1: #ab9b8e;
        --palette-2: #8690a2;
        --palette-3: #d2c296;
        --palette-4: #b4d1d3;
        --palette-5: #e0decd;
    }

    .theme-btn.sakura {
        --theme-preview: #ae5d5c;
        --theme-surface: #e5dfe9;
        --theme-ink: #704645;
        --theme-accent: #eb908f;
        --palette-1: #ae5d5c;
        --palette-2: #eb908f;
        --palette-3: #abacba;
        --palette-4: #b6d1ef;
        --palette-5: #e5dfe9;
    }

    .theme-btn.galaxy {
        --theme-preview: #ff2446;
        --theme-surface: #e6e1e1;
        --theme-ink: #7f2437;
        --theme-accent: #ff7c96;
        --palette-1: #ff2446;
        --palette-2: #ff7c96;
        --palette-3: #f5b6c2;
        --palette-4: #d8c3c3;
        --palette-5: #e6e1e1;
    }

    .theme-btn.cyberpunk {
        --theme-preview: #1c3704;
        --theme-surface: #d4d9de;
        --theme-ink: #24331b;
        --theme-accent: #4b6c34;
        --palette-1: #1c3704;
        --palette-2: #4b6c34;
        --palette-3: #8cb5b4;
        --palette-4: #a4b4c4;
        --palette-5: #d4d9de;
    }

    .theme-btn.matcha {
        --theme-preview: #5d011b;
        --theme-surface: #dedede;
        --theme-ink: #3d3432;
        --theme-accent: #c12457;
        --palette-1: #3a3937;
        --palette-2: #5d011b;
        --palette-3: #c12457;
        --palette-4: #cc9059;
        --palette-5: #dedede;
    }

    [data-theme-mode="dark"] .theme-btn.pastel {
        --theme-preview: #aeb6c4;
        --theme-surface: #1e1a19;
        --theme-ink: #eee7dc;
        --theme-accent: #d9c89a;
        --palette-1: #403731;
        --palette-2: #aeb6c4;
        --palette-3: #d9c89a;
        --palette-4: #5f777c;
        --palette-5: #1e1a19;
    }

    [data-theme-mode="dark"] .theme-btn.sakura {
        --theme-preview: #d98b88;
        --theme-surface: #211718;
        --theme-ink: #f4e7e7;
        --theme-accent: #d1daf2;
        --palette-1: #4a292b;
        --palette-2: #d98b88;
        --palette-3: #8b8ea2;
        --palette-4: #d1daf2;
        --palette-5: #211718;
    }

    [data-theme-mode="dark"] .theme-btn.galaxy {
        --theme-preview: #ff8ea0;
        --theme-surface: #221417;
        --theme-ink: #ffe9ee;
        --theme-accent: #f8c0c9;
        --palette-1: #642330;
        --palette-2: #ff8ea0;
        --palette-3: #f8c0c9;
        --palette-4: #8d6b73;
        --palette-5: #221417;
    }

    [data-theme-mode="dark"] .theme-btn.cyberpunk {
        --theme-preview: #8eb57a;
        --theme-surface: #10170f;
        --theme-ink: #edf4ec;
        --theme-accent: #94c2c0;
        --palette-1: #203818;
        --palette-2: #8eb57a;
        --palette-3: #94c2c0;
        --palette-4: #5d6c7d;
        --palette-5: #10170f;
    }

    [data-theme-mode="dark"] .theme-btn.matcha {
        --theme-preview: #d66f8d;
        --theme-surface: #171314;
        --theme-ink: #f6e9e6;
        --theme-accent: #d9a16d;
        --palette-1: #4d4b4b;
        --palette-2: #8a213d;
        --palette-3: #d66f8d;
        --palette-4: #d9a16d;
        --palette-5: #171314;
    }

    .notification-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-top: 1rem;
    }

    .notification-toggle,
    .action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
    }

    .notification-hint,
    .notification-feedback,
    .status-message {
        padding: 1rem;
        border-radius: 12px;
        font-size: var(--font-size-body-sm);
    }

    .notification-hint,
    .notification-feedback,
    .status-message {
        background-color: var(--card-border);
    }

    .blocked-hint {
        color: #f43f5e;
        background: rgba(244, 63, 94, 0.12);
    }

    .notification-feedback {
        color: var(--success-color);
    }

    .logout-btn {
        color: #f43f5e;
        border-color: rgba(244, 63, 94, 0.25);
        background: rgba(244, 63, 94, 0.08);
    }

    .settings-link-card {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        text-align: left;
        padding: 1rem 0;
        border: none;
        border-top: 1px solid var(--card-border);
        background: transparent;
        color: var(--text-color);
        cursor: pointer;
    }

    .settings-link-card:first-of-type {
        border-top: none;
        padding-top: 0;
    }

    .settings-link-card:last-of-type {
        padding-bottom: 0;
    }

    .settings-link-copy h3 {
        margin: 0;
        font-size: var(--font-size-card-title);
    }

    .settings-link-copy p {
        margin: 0.3rem 0 0;
        color: var(--text-muted);
        font-size: var(--font-size-body-sm);
    }

    .settings-link-meta {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        flex-shrink: 0;
    }

    .settings-count-pill {
        min-width: 44px;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        background: var(--card-border);
        color: var(--text-color);
        text-align: center;
        font-size: var(--font-size-badge);
        font-weight: 700;
    }

    .settings-chevron {
        font-size: calc(var(--font-size-section-title) + 0.2rem);
        line-height: 1;
        color: var(--text-muted);
    }

    .settings-link-card:hover .settings-chevron,
    .settings-link-card:hover .settings-link-copy h3 {
        color: var(--primary-color);
    }

    .data-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .action-btn {
        flex: 1;
        min-width: 150px;
    }

    @@media (max-width: 720px) {
        .setting-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .status-pill,
        .notification-toggle,
        .settings-link-card {
            align-self: stretch;
            width: 100%;
        }

        .settings-link-card {
            padding-right: 0;
        }
    }
</style>

@code {
    private string statusMessage = "";
    private string notificationMessage = "";
    private int archivedHabitCount;
    private int activeReminderHabitCount;
    private bool isCollectionsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
        NotificationService.StatusChanged += HandleNotificationStatusChanged;
        DbService.DataChanged += HandleDatabaseChanged;
        await LoadSettingsCollectionsAsync();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
        NotificationService.StatusChanged -= HandleNotificationStatusChanged;
        DbService.DataChanged -= HandleDatabaseChanged;
    }

    private async Task SetTheme(string theme)
    {
        await ThemeService.SetThemeAsync(theme);
    }

    private async Task ToggleNotifications()
    {
        if (NotificationService.AppNotificationsEnabled)
        {
            await NotificationService.DisableNotificationsAsync();
            notificationMessage = "Notifications are off for this device.";
        }
        else
        {
            await NotificationService.EnableNotificationsAsync();
            notificationMessage = NotificationService.AppNotificationsEnabled
                ? "Notifications are enabled for this device."
                : "Notifications could not be enabled. Check your browser permission settings.";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExportData()
    {
        var json = await DbService.ExportDataAsync();
        var fileName = $"habitee-backup-{DateTime.Now:yyyyMMdd}.json";

        await JSRuntime.InvokeVoidAsync("eval", $@"
            (function() {{
                const blob = new Blob([{JsonSerializer.Serialize(json)}], {{ type: 'application/json' }});
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }})();
        ");

        statusMessage = "Data exported successfully!";
        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = "";
        StateHasChanged();
    }

    private async Task ImportData(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null)
            {
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var success = await DbService.ImportDataAsync(json);
            statusMessage = success
                ? "Data imported successfully!"
                : "Failed to import data. Invalid format.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
        }

        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = "";
        StateHasChanged();
    }

    private string GetNotificationStatusLabel()
    {
        return NotificationService.Permission switch
        {
            "denied" => "Blocked",
            "unsupported" => "Unavailable",
            _ when NotificationService.AppNotificationsEnabled => "Enabled",
            _ => "Off"
        };
    }

    private string GetNotificationStatusDescription()
    {
        return NotificationService.Permission switch
        {
            "denied" => "Notifications are blocked in your browser settings for this site.",
            "unsupported" => "This browser cannot show Habitee notifications.",
            _ when NotificationService.AppNotificationsEnabled => "Habit reminders and updates are on for this device.",
            _ => "Turn notifications on to receive habit reminders and updates."
        };
    }

    private string GetNotificationStatusClass()
    {
        return NotificationService.Permission switch
        {
            "denied" => "blocked",
            "unsupported" => "unsupported",
            _ when NotificationService.AppNotificationsEnabled => "enabled",
            _ => "pending"
        };
    }

    private async Task LoadSettingsCollectionsAsync()
    {
        isCollectionsLoading = true;
        archivedHabitCount = (await DbService.GetArchivedHabitsAsync()).Count;
        activeReminderHabitCount = (await DbService.GetHabitsWithActiveRemindersAsync()).Count;
        isCollectionsLoading = false;
    }

    private void HandleNotificationStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleDatabaseChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSettingsCollectionsAsync();
            StateHasChanged();
        });
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/");
    }
}
