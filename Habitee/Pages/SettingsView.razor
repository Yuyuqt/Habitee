@page "/settings"
@using Habitee.Services
@using System.Text.Json
@implements IDisposable
@inject ThemeService ThemeService
@inject DatabaseService DbService
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService
@inject NavigationManager NavManager
@inject AuthService AuthService

<div class="container">
    <header class="view-header">
        <h1 class="view-title">Settings</h1>
    </header>

    <div class="settings-grid">
        <section class="settings-section glass-panel">
            <h2>Appearance</h2>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Dark Mode</h3>
                    <p>Toggle between light and dark themes</p>
                </div>
                <button class="glass-button toggle-btn @(ThemeService.CurrentMode == "dark" ? "active" : "")" @onclick="ToggleMode">
                    @(ThemeService.CurrentMode == "dark" ? "On" : "Off")
                </button>
            </div>

            <div class="setting-item setting-stack">
                <div class="setting-info">
                    <h3>Theme</h3>
                    <p>Choose your aesthetic</p>
                </div>
                <div class="theme-selector">
                    <button class="theme-btn habitee @(ThemeService.CurrentTheme == "habitee" ? "selected" : "")" @onclick="@(() => SetTheme("habitee"))">Habitee+</button>
                    <button class="theme-btn pastel @(ThemeService.CurrentTheme == "pastel" ? "selected" : "")" @onclick="@(() => SetTheme("pastel"))">Pastel Dream</button>
                    <button class="theme-btn sakura @(ThemeService.CurrentTheme == "sakura" ? "selected" : "")" @onclick="@(() => SetTheme("sakura"))">Sakura</button>
                    <button class="theme-btn galaxy @(ThemeService.CurrentTheme == "galaxy" ? "selected" : "")" @onclick="@(() => SetTheme("galaxy"))">Starry Galaxy</button>
                    <button class="theme-btn cyberpunk @(ThemeService.CurrentTheme == "cyberpunk" ? "selected" : "")" @onclick="@(() => SetTheme("cyberpunk"))">Cyberpunk</button>
                    <button class="theme-btn matcha @(ThemeService.CurrentTheme == "matcha" ? "selected" : "")" @onclick="@(() => SetTheme("matcha"))">Matcha Latte</button>
                    <button class="theme-btn retro @(ThemeService.CurrentTheme == "retro" ? "selected" : "")" @onclick="@(() => SetTheme("retro"))">Retro Arcade</button>
                    <button class="theme-btn ocean @(ThemeService.CurrentTheme == "ocean" ? "selected" : "")" @onclick="@(() => SetTheme("ocean"))">Deep Sea</button>
                    <button class="theme-btn paper @(ThemeService.CurrentTheme == "paper" ? "selected" : "")" @onclick="@(() => SetTheme("paper"))">Paper Sketch</button>
                </div>
            </div>
        </section>

        <section class="settings-section glass-panel">
            <h2>Account</h2>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>@(AuthService.CurrentUser?.DisplayName ?? "Local account")</h3>
                    <p>@(AuthService.CurrentUser?.Email ?? "Signed in on this device")</p>
                </div>
                <button class="glass-button logout-btn" @onclick="Logout">
                    Log Out
                </button>
            </div>
        </section>

        <section class="settings-section glass-panel">
            <h2>Notifications</h2>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Habit Reminders</h3>
                    <p>@GetNotificationStatusDescription()</p>
                </div>
                <span class="status-pill @GetNotificationStatusClass()">@GetNotificationStatusLabel()</span>
            </div>

            <div class="notification-actions">
                @if (NotificationService.Permission == "denied")
                {
                    <div class="notification-hint blocked-hint">
                        Notifications are blocked in your browser settings. Re-enable them there, then come back to Habitee.
                    </div>
                }
                else if (!NotificationService.IsSupported)
                {
                    <div class="notification-hint">
                        This browser cannot show notifications for Habitee.
                    </div>
                }
                else
                {
                    <button class="glass-button notification-toggle @(NotificationService.AppNotificationsEnabled ? "active" : "")"
                            @onclick="ToggleNotifications">
                        @(NotificationService.AppNotificationsEnabled ? "Disable Notifications" : "Enable Notifications")
                    </button>
                }

                @if (!string.IsNullOrWhiteSpace(notificationMessage))
                {
                    <div class="notification-feedback fade-in">@notificationMessage</div>
                }
            </div>
        </section>

        <section class="settings-section glass-panel">
            <h2>Habit Library</h2>
            <p class="section-copy">Peek into your reminder-ready and archived habits without crowding the main settings page.</p>

            <button class="settings-link-card" @onclick='() => NavManager.NavigateTo("/settings/active-reminders")'>
                <div class="settings-link-copy">
                    <h3>Active Reminders</h3>
                    <p>See every active habit with at least one enabled reminder.</p>
                </div>
                <div class="settings-link-meta">
                    <span class="settings-count-pill">@(isCollectionsLoading ? "..." : activeReminderHabitCount.ToString())</span>
                    <span class="settings-chevron" aria-hidden="true">›</span>
                </div>
            </button>

            <button class="settings-link-card" @onclick='() => NavManager.NavigateTo("/settings/archived-habits")'>
                <div class="settings-link-copy">
                    <h3>Archived Habits</h3>
                    <p>Review hidden habits, then restore or delete them from a dedicated page.</p>
                </div>
                <div class="settings-link-meta">
                    <span class="settings-count-pill">@(isCollectionsLoading ? "..." : archivedHabitCount.ToString())</span>
                    <span class="settings-chevron" aria-hidden="true">›</span>
                </div>
            </button>
        </section>

        <section class="settings-section glass-panel">
            <h2>Data Management</h2>
            <p class="section-copy">Habitee is local-first. Your data never leaves your device. Export your data to back it up or move to another device.</p>

            <div class="data-actions">
                <button class="glass-button action-btn export" @onclick="ExportData">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                    Export JSON
                </button>

                <InputFile OnChange="ImportData" id="fileInput" accept=".json" style="display:none;" />
                <button class="glass-button action-btn import" onclick="document.getElementById('fileInput').click()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
                    Import JSON
                </button>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="status-message fade-in">@statusMessage</div>
            }
        </section>
    </div>
</div>

<style>
    .view-header {
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .view-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0;
        background: linear-gradient(to right, var(--text-color), var(--primary-color));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .settings-grid {
        display: grid;
        gap: 2rem;
        max-width: 800px;
    }

    .settings-section {
        padding: 2rem;
    }

    .settings-section h2 {
        margin-top: 0;
        margin-bottom: 1.5rem;
        font-size: 1.5rem;
    }

    .section-copy {
        margin-bottom: 1.5rem;
    }

    .setting-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid var(--card-border);
        gap: 1rem;
    }

    .setting-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .setting-stack {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .setting-info h3 {
        margin: 0;
        font-size: 1.1rem;
    }

    .setting-info p {
        margin: 0;
        font-size: 0.9rem;
    }

    .toggle-btn {
        min-width: 80px;
    }

    .toggle-btn.active,
    .notification-toggle.active {
        background: var(--primary-color);
        color: white;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 96px;
        padding: 0.65rem 0.9rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 700;
        text-align: center;
    }

    .status-pill.enabled {
        background: color-mix(in srgb, var(--success-color) 88%, transparent);
        color: white;
    }

    .status-pill.blocked {
        background: rgba(244, 63, 94, 0.12);
        color: #f43f5e;
    }

    .status-pill.pending,
    .status-pill.unsupported {
        background: var(--card-border);
        color: var(--text-color);
    }

    .theme-selector {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        width: 100%;
    }

    .theme-btn {
        padding: 1rem;
        border-radius: 12px;
        border: 2px solid transparent;
        background: var(--theme-btn-bg, var(--card-border));
        color: var(--theme-btn-text, var(--text-color));
        cursor: pointer;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .theme-btn.selected {
        border-color: var(--primary-color);
        box-shadow: 0 0 15px color-mix(in srgb, var(--primary-color) 28%, transparent);
    }

    .theme-btn.habitee { border-left: 4px solid #3b82f6; }
    .theme-btn.pastel { border-left: 4px solid #a0dee6; font-family: 'Comfortaa', cursive; }
    .theme-btn.sakura { border-left: 4px solid #df7fa3; font-family: 'Quicksand', 'Nunito', sans-serif; }
    .theme-btn.galaxy { border-left: 4px solid #8b5cf6; }
    .theme-btn.cyberpunk { border-left: 4px solid #f43f5e; font-family: 'JetBrains Mono', monospace; }
    .theme-btn.matcha { border-left: 4px solid #7b9165; font-family: 'Nunito', 'Quicksand', sans-serif; }
    .theme-btn.retro { border-left: 4px solid #ff4fd8; font-family: 'Press Start 2P', 'JetBrains Mono', monospace; font-size: 0.7rem; line-height: 1.4; }
    .theme-btn.ocean { border-left: 4px solid #0c90b6; font-family: 'Nunito', 'Inter', sans-serif; }
    .theme-btn.paper { border-left: 4px solid #2f76b8; font-family: 'Quicksand', 'Nunito', sans-serif; }

    .notification-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-top: 1rem;
    }

    .notification-toggle,
    .action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1rem;
    }

    .notification-hint,
    .notification-feedback,
    .status-message {
        padding: 1rem;
        border-radius: 12px;
        font-size: 0.92rem;
    }

    .notification-hint,
    .notification-feedback,
    .status-message {
        background-color: var(--card-border);
    }

    .blocked-hint {
        color: #f43f5e;
        background: rgba(244, 63, 94, 0.12);
    }

    .notification-feedback {
        color: var(--success-color);
    }

    .logout-btn {
        color: #f43f5e;
        border-color: rgba(244, 63, 94, 0.25);
        background: rgba(244, 63, 94, 0.08);
    }

    .settings-link-card {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        text-align: left;
        padding: 1rem 0;
        border: none;
        border-top: 1px solid var(--card-border);
        background: transparent;
        color: var(--text-color);
        cursor: pointer;
    }

    .settings-link-card:first-of-type {
        border-top: none;
        padding-top: 0;
    }

    .settings-link-card:last-of-type {
        padding-bottom: 0;
    }

    .settings-link-copy h3 {
        margin: 0;
        font-size: 1.05rem;
    }

    .settings-link-copy p {
        margin: 0.3rem 0 0;
        color: var(--text-muted);
        font-size: 0.92rem;
    }

    .settings-link-meta {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        flex-shrink: 0;
    }

    .settings-count-pill {
        min-width: 44px;
        padding: 0.45rem 0.75rem;
        border-radius: 999px;
        background: var(--card-border);
        color: var(--text-color);
        text-align: center;
        font-size: 0.85rem;
        font-weight: 700;
    }

    .settings-chevron {
        font-size: 1.7rem;
        line-height: 1;
        color: var(--text-muted);
    }

    .settings-link-card:hover .settings-chevron,
    .settings-link-card:hover .settings-link-copy h3 {
        color: var(--primary-color);
    }

    .data-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .action-btn {
        flex: 1;
        min-width: 150px;
    }

    @@media (max-width: 720px) {
        .setting-item {
            flex-direction: column;
            align-items: flex-start;
        }

        .status-pill,
        .notification-toggle,
        .settings-link-card {
            align-self: stretch;
            width: 100%;
        }

        .settings-link-card {
            padding-right: 0;
        }
    }
</style>

@code {
    private string statusMessage = "";
    private string notificationMessage = "";
    private int archivedHabitCount;
    private int activeReminderHabitCount;
    private bool isCollectionsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
        NotificationService.StatusChanged += HandleNotificationStatusChanged;
        DbService.DataChanged += HandleDatabaseChanged;
        await LoadSettingsCollectionsAsync();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
        NotificationService.StatusChanged -= HandleNotificationStatusChanged;
        DbService.DataChanged -= HandleDatabaseChanged;
    }

    private async Task ToggleMode()
    {
        await ThemeService.ToggleModeAsync();
    }

    private async Task SetTheme(string theme)
    {
        await ThemeService.SetThemeAsync(theme);
    }

    private async Task ToggleNotifications()
    {
        if (NotificationService.AppNotificationsEnabled)
        {
            await NotificationService.DisableNotificationsAsync();
            notificationMessage = "Notifications are off for this device.";
        }
        else
        {
            await NotificationService.EnableNotificationsAsync();
            notificationMessage = NotificationService.AppNotificationsEnabled
                ? "Notifications are enabled for this device."
                : "Notifications could not be enabled. Check your browser permission settings.";
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ExportData()
    {
        var json = await DbService.ExportDataAsync();
        var fileName = $"habitee-backup-{DateTime.Now:yyyyMMdd}.json";

        await JSRuntime.InvokeVoidAsync("eval", $@"
            (function() {{
                const blob = new Blob([{JsonSerializer.Serialize(json)}], {{ type: 'application/json' }});
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }})();
        ");

        statusMessage = "Data exported successfully!";
        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = "";
        StateHasChanged();
    }

    private async Task ImportData(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null)
            {
                return;
            }

            using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 5);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();

            var success = await DbService.ImportDataAsync(json);
            statusMessage = success
                ? "Data imported successfully!"
                : "Failed to import data. Invalid format.";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
        }

        StateHasChanged();
        await Task.Delay(3000);
        statusMessage = "";
        StateHasChanged();
    }

    private string GetNotificationStatusLabel()
    {
        return NotificationService.Permission switch
        {
            "denied" => "Blocked",
            "unsupported" => "Unavailable",
            _ when NotificationService.AppNotificationsEnabled => "Enabled",
            _ => "Off"
        };
    }

    private string GetNotificationStatusDescription()
    {
        return NotificationService.Permission switch
        {
            "denied" => "Notifications are blocked in your browser settings for this site.",
            "unsupported" => "This browser cannot show Habitee notifications.",
            _ when NotificationService.AppNotificationsEnabled => "Habit reminders and updates are on for this device.",
            _ => "Turn notifications on to receive habit reminders and updates."
        };
    }

    private string GetNotificationStatusClass()
    {
        return NotificationService.Permission switch
        {
            "denied" => "blocked",
            "unsupported" => "unsupported",
            _ when NotificationService.AppNotificationsEnabled => "enabled",
            _ => "pending"
        };
    }

    private async Task LoadSettingsCollectionsAsync()
    {
        isCollectionsLoading = true;
        archivedHabitCount = (await DbService.GetArchivedHabitsAsync()).Count;
        activeReminderHabitCount = (await DbService.GetHabitsWithActiveRemindersAsync()).Count;
        isCollectionsLoading = false;
    }

    private void HandleNotificationStatusChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleDatabaseChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadSettingsCollectionsAsync();
            StateHasChanged();
        });
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavManager.NavigateTo("/");
    }
}
