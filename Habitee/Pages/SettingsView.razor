@page "/settings"
@using Habitee.Services
@using System.Text.Json
@implements IDisposable
@inject ThemeService ThemeService
@inject DatabaseService DbService
@inject IJSRuntime JSRuntime
@inject NotificationService NotificationService
@inject NavigationManager NavManager
@inject AuthService AuthService

<div class="container">
    <header class="view-header">
        <h1 class="view-title">Settings</h1>
    </header>

    <div class="settings-grid">
        <section class="settings-section glass-panel">
            <h2>Appearance</h2>

            <div class="setting-item setting-stack">
                <div class="setting-info">
                    <h3>Theme</h3>
                    <p>Choose your aesthetic</p>
                </div>
                <div class="theme-selector">
                    <button class="theme-btn habitee @(ThemeService.CurrentTheme == "habitee" ? "selected" : "")" 
                            @onclick='() => SetTheme("habitee")'>
                        <div class="preview"></div>
                        <span>Habitee+</span>
                    </button>
                    
                    <button class="theme-btn pastel @(ThemeService.CurrentTheme == "pastel" ? "selected" : "")" 
                            @onclick='() => SetTheme("pastel")'>
                        <div class="preview"></div>
                        <span>Gilded Feather</span>
                    </button>
                    
                    <button class="theme-btn sakura @(ThemeService.CurrentTheme == "sakura" ? "selected" : "")" 
                            @onclick='() => SetTheme("sakura")'>
                        <div class="preview"></div>
                        <span>Blush Coast</span>
                    </button>
                    
                    <button class="theme-btn galaxy @(ThemeService.CurrentTheme == "galaxy" ? "selected" : "")" 
                            @onclick='() => SetTheme("galaxy")'>
                        <div class="preview"></div>
                        <span>Cherry Fizz</span>
                    </button>
                    
                    <button class="theme-btn cyberpunk @(ThemeService.CurrentTheme == "cyberpunk" ? "selected" : "")" 
                            @onclick='() => SetTheme("cyberpunk")'>
                        <div class="preview"></div>
                        <span>Quiet Grove</span>
                    </button>
                    
                    <button class="theme-btn matcha @(ThemeService.CurrentTheme == "matcha" ? "selected" : "")" 
                            @onclick='() => SetTheme("matcha")'>
                        <div class="preview"></div>
                        <span>Velvet Spiral</span>
                    </button>
                </div>
            </div>
        </section>

        <section class="settings-section glass-panel">
            <h2>Account</h2>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>@(AuthService.CurrentUser?.DisplayName ?? "Local account")</h3>
                    <p>@(AuthService.CurrentUser?.Email ?? "Signed in on this device")</p>
                </div>
                <button class="glass-button logout-btn" @onclick="Logout">
                    Log Out
                </button>
            </div>
        </section>

        <section class="settings-section glass-panel">
            <h2>Notifications</h2>

            <div class="setting-item">
                <div class="setting-info">
                    <h3>Habit Reminders</h3>
                    <p>@GetNotificationStatusDescription()</p>
                </div>
                <span class="status-pill @GetNotificationStatusClass()">@GetNotificationStatusLabel()</span>
            </div>

            <div class="notification-actions">
                @if (NotificationService.Permission == "denied")
                {
                    <div class="notification-hint blocked-hint">
                        Notifications are blocked in your browser settings. Re-enable them there, then come back to Habitee.
                    </div>
                }
                else if (!NotificationService.IsSupported)
                {
                    <div class="notification-hint">
                        This browser cannot show notifications for Habitee.
                    </div>
                }
                else
                {
                    <button class="glass-button notification-toggle @(NotificationService.AppNotificationsEnabled ? "active" : "")"
                            @onclick="ToggleNotifications">
                        @(NotificationService.AppNotificationsEnabled ? "Disable Notifications" : "Enable Notifications")
                    </button>
                }

                @if (!string.IsNullOrWhiteSpace(notificationMessage))
                {
                    <div class="notification-feedback fade-in">@notificationMessage</div>
                }
            </div>
        </section>

        <section class="settings-section glass-panel">
            <h2>Habit Library</h2>
            <p class="section-copy">Peek into your reminder-ready and archived habits without crowding the main settings page.</p>

            <button class="settings-link-card" @onclick='() => NavManager.NavigateTo("/settings/active-reminders")'>
                <div class="settings-link-copy">
                    <h3>Active Reminders</h3>
                    <p>See every active habit with at least one enabled reminder.</p>
                </div>
                <div class="settings-link-meta">
                    <span class="settings-count-pill">@(isCollectionsLoading ? "..." : activeReminderHabitCount.ToString())</span>
                    <span class="settings-chevron" aria-hidden="true">›</span>
                </div>
            </button>

            <button class="settings-link-card" @onclick='() => NavManager.NavigateTo("/settings/archived-habits")'>
                <div class="settings-link-copy">
                    <h3>Archived Habits</h3>
                    <p>Review hidden habits, then restore or delete them from a dedicated page.</p>
                </div>
                <div class="settings-link-meta">
                    <span class="settings-count-pill">@(isCollectionsLoading ? "..." : archivedHabitCount.ToString())</span>
                    <span class="settings-chevron" aria-hidden="true">›</span>
                </div>
            </button>
        </section>

        <section class="settings-section glass-panel">
            <h2>Data Management</h2>
            <p class="section-copy">Habitee is local-first. Your data never leaves your device. Export your data to back it up or move to another device.</p>

            <div class="data-actions">
                <button class="glass-button action-btn export" @onclick="ExportData">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
                    Export JSON
                </button>

                <InputFile OnChange="ImportData" id="fileInput" accept=".json" style="display:none;" />
                <button class="glass-button action-btn import" onclick="document.getElementById('fileInput').click()">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
                    Import JSON
                </button>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="status-message fade-in">@statusMessage</div>
            }
        </section>
    </div>
</div>

<style>
    .view-header {
        margin-bottom: 2rem;
        padding-top: 2rem;
    }

    .view-title {
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
        margin: 0;
        color: var(--text-color);
    }

    .settings-grid {
        display: grid;
        gap: 2rem;
        max-width: 800px;
    }

    .settings-section {
        padding: 2rem;
    }

    .settings-section h2 {
        margin-top: 0;
        margin-bottom: 1.5rem;
        font-size: var(--font-size-section-title);
    }

    .section-copy {
        margin-bottom: 1.5rem;
        font-size: var(--font-size-body-sm);
        color: var(--text-muted);
    }

    .setting-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid var(--card-border);
        gap: 1rem;
    }

    .setting-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .setting-stack {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    .setting-info h3 {
        margin: 0;
        font-size: var(--font-size-card-title);
    }

    .setting-info p {
        margin: 0;
        font-size: var(--font-size-body-sm);
        color: var(--text-muted);
    }

    .notification-toggle.active {
        background: var(--primary-color);
        color: var(--primary-contrast);
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 96px;
        padding: 0.65rem 0.9rem;
        border-radius: 999px;
        font-size: var(--font-size-badge);
        font-weight: 700;
        text-align: center;
    }

    .status-pill.enabled {
        background: color-mix(in srgb, var(--success-color) 88%, transparent);
        color: color-mix(in srgb, var(--success-color) 16%, #12222a 84%);
    }

    .status-pill.blocked {
        background: rgba(244, 63, 94, 0.12);
        color: #f43f5e;
    }

    .status-pill.pending,
    .status-pill.unsupported {
        background: var(--card-border);
        color: var(--text-color);
    }

    .theme-selector {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 1rem;
        width: 100%;
    }

    .theme-btn {
        --theme-preview: var(--primary-color);
        --theme-surface: var(--card-bg);
        --theme-ink: var(--text-color);
        --theme-accent: var(--accent-color);
        --palette-1: var(--theme-preview);
        --palette-2: var(--theme-accent);
        --palette-3: color-mix(in srgb, var(--theme-preview) 45%, var(--theme-surface));
        --palette-4: color-mix(in srgb, var(--theme-accent) 28%, var(--theme-surface));
        --palette-5: var(--theme-surface);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 1rem;
        border-radius: 14px;
        border: 1px solid color-mix(in srgb, var(--theme-preview) 22%, var(--theme-ink) 10%);
        background:
            linear-gradient(135deg,
                color-mix(in srgb, var(--palette-5) 88%, white 12%) 0%,
                color-mix(in srgb, var(--palette-4) 52%, var(--palette-5)) 100%);
        color: var(--theme-ink);
        cursor: pointer;
        font-weight: 600;
        transition: background-color 0.16s ease, border-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
        font-size: var(--font-size-body-sm);
        box-shadow: none;
        text-align: left;
    }

    .theme-btn .preview {
        width: 100%;
        height: 3.5rem;
        border-radius: 12px;
        border: 1px solid color-mix(in srgb, var(--theme-ink) 10%, transparent);
        background:
            linear-gradient(90deg,
                var(--palette-1) 0% 20%,
                var(--palette-2) 20% 40%,
                var(--palette-3) 40% 60%,
                var(--palette-4) 60% 80%,
                var(--palette-5) 80% 100%);
        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.35),
            inset 0 -10px 20px rgba(0, 0, 0, 0.04);
    }

    .theme-btn span {
        display: block;
    }

    .theme-btn:hover {
        background:
            linear-gradient(135deg,
                color-mix(in srgb, var(--palette-5) 82%, white 18%) 0%,
                color-mix(in srgb, var(--palette-3) 42%, var(--palette-5)) 100%);
    }

    .theme-btn.selected {
        border-color: var(--theme-preview);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--theme-preview) 26%, transparent);
    }

    .theme-btn.habitee {
        --theme-preview: #2563eb;
        --theme-surface: #f8fafc;
        --theme-ink: #1e293b;
        --theme-accent: #60a5fa;
        --palette-1: #2563eb;
        --palette-2: #60a5fa;
        --palette-3: #93c5fd;
        --palette-4: #dbeafe;
        --palette-5: #f8fafc;
    }

