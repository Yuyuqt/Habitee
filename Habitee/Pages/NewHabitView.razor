@page "/new-habit"
@using Habitee.Models
@using Habitee.Services
@inject NavigationManager NavManager
@inject DatabaseService DbService
@inject HabitDraftService DraftService

<div class="view-container slide-in">
    <header class="app-header">
        <button class="icon-btn" @onclick="NavigateBack">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <h1 class="header-title">@(isEditing ? "Edit Habit" : "New Habit")</h1>
        <div style="width: 24px;"></div>
    </header>

    <div class="form-container content-scroll">
        <div class="form-row top-row">
            <div class="input-group" style="flex: 1;">
                <label>NAME</label>
                <input type="text" class="glass-input" @bind="habit.Title" @bind:event="oninput" />
            </div>

            <div class="picker-group">
                <div class="input-group">
                    <label>ICON</label>
                    <button type="button" class="picker-btn glass-panel" style="color: @habit.Color;" @onclick="OpenIconPicker">
                        @if (string.IsNullOrWhiteSpace(habit.Icon))
                        {
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <path d="M12 8v8"></path>
                                <path d="M8 12h8"></path>
                            </svg>
                        }
                        else
                        {
                            <HabitIcon Name="@habit.Icon" Color="@habit.Color" Size="24" />
                        }
                    </button>
                </div>
            </div>
        </div>

        <div class="input-group">
            <label>DESCRIPTION</label>
            <input type="text" class="glass-input" placeholder="Optional" @bind="habit.Description" />
        </div>

        <div class="input-group">
            <label>COMPLETIONS PER DAY</label>
            <div class="stepper-row">
                <div class="glass-input stepper-display">
                    @habit.TargetCount / Day
                </div>
                <button type="button" class="stepper-btn glass-panel" @onclick="DecrementCount">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
                <button type="button" class="stepper-btn glass-panel" @onclick="OpenCountEditor">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </button>
                <button type="button" class="stepper-btn glass-panel" @onclick="IncrementCount">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
            </div>
        </div>

        <div class="input-group">
            <label>HOW SHOULD COMPLETIONS BE TRACKED?</label>
            <div class="segmented-control glass-panel">
                <button type="button" class="segment @(IsTrackingMode("StepByStep"))" @onclick='() => SetTrackingMode("StepByStep")'>Step by step</button>
                <button type="button" class="segment @(IsTrackingMode("CustomValue"))" @onclick='() => SetTrackingMode("CustomValue")'>Custom value</button>
            </div>
            <div class="frequency-choice-row">
                @foreach (var option in frequencyOptions)
                {
                    <button type="button" class="mini-choice @(IsFrequency(option))" @onclick='() => SetFrequency(option)'>@option</button>
                }
            </div>
        </div>

        <div class="input-group">
            <label>FREQUENCY & REMINDERS</label>
            <button type="button" class="glass-input picker-dropdown" @onclick='() => NavManager.NavigateTo("/habit-frequency")'>
                <span>@GetFrequencySummary()</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
        </div>

        <div class="form-bottom-spacer"></div>
    </div>

    <div class="fixed-bottom">
        <button class="primary-btn glass-button" disabled="@string.IsNullOrWhiteSpace(habit.Title)" @onclick="SaveHabit">
            @(isEditing ? "Save Changes" : "Save")
        </button>
    </div>
</div>

@if (isCountEditorOpen)
{
    <div class="modal-backdrop" @onclick="CloseCountEditor">
        <div class="count-modal glass-panel" @onclick:stopPropagation="true">
            <div class="count-modal-copy">
                <h3>Set completions per day</h3>
                <p>Numbers only.</p>
            </div>
            <input class="glass-input count-input"
                   inputmode="numeric"
                   pattern="[0-9]*"
                   @bind="editCountText"
                   @bind:event="oninput" />
            @if (!string.IsNullOrWhiteSpace(countEditorError))
            {
                <p class="error-text">@countEditorError</p>
            }
            <div class="count-modal-actions">
                <button type="button" class="modal-btn glass-panel" @onclick="CloseCountEditor">Cancel</button>
                <button type="button" class="modal-btn modal-primary" @onclick="SaveEditedCount">Save</button>
            </div>
        </div>
    </div>
}

@if (isIconPickerOpen)
{
    <Habitee.Components.IconPickerModal
        SelectedIcon="@habit.Icon"
        SelectedColor="@habit.Color"
        OnIconSelected="SelectIcon"
        OnColorSelected="SelectColor"
        OnClose="CloseIconPicker" />
}

<style>
    .view-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        max-width: 820px;
        margin: 0 auto;
        position: relative;
        padding-top: 2.5rem;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 1.5rem 1.5rem;
    }

    .header-title {
        font-size: var(--font-size-page-title);
        font-weight: 800;
        line-height: var(--line-height-title);
        margin: 0;
        text-align: center;
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding: 0 1rem;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem;
        padding-bottom: calc(var(--page-action-clearance) + 1.5rem);
        min-height: 0;
    }

    .form-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form-bottom-spacer {
        height: 1.5rem;
        flex-shrink: 0;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .input-group label {
        font-size: var(--font-size-label);
        font-weight: 700;
        color: var(--text-muted);
        letter-spacing: 1px;
    }

    .glass-input {
        width: 100%;
        padding: 1rem;
        border-radius: 16px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        font-family: inherit;
        font-size: var(--font-size-body);
    }

    .top-row {
        align-items: flex-start;
    }

    .form-row {
        display: flex;
        gap: 1rem;
    }

    .picker-group {
        display: flex;
        gap: 1rem;
    }

    .picker-btn {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        cursor: pointer;
        padding: 0;
    }

    .stepper-row {
        display: flex;
        gap: 0.75rem;
    }

    .stepper-display {
        flex: 1;
        display: flex;
        align-items: center;
    }

    .stepper-btn {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 16px;
        cursor: pointer;
        color: var(--text-color);
        padding: 0;
    }

    .segmented-control {
        display: flex;
        padding: 0;
        border-radius: 14px;
        gap: 0;
        overflow: hidden;
        border: var(--outline-width, 1px) solid var(--card-border);
    }

    .segment {
        flex: 1;
        padding: 0.9rem 1rem;
        border: none;
        background: transparent;
        color: var(--text-muted);
        font-weight: 700;
        border-radius: 0;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease;
        font-size: var(--font-size-body-sm);
    }

    .segment.active {
        background: var(--primary-color);
        color: var(--primary-contrast);
    }

    .segment:hover:not(.active) {
        background: color-mix(in srgb, var(--button-hover-surface) 86%, transparent);
        color: var(--text-color);
    }

    .frequency-choice-row {
        display: flex;
        gap: 0.6rem;
        flex-wrap: wrap;
    }

    .mini-choice {
        min-width: 110px;
        padding: 0.8rem 1rem;
        border-radius: 14px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-muted);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        font-size: var(--font-size-body-sm);
    }

    .mini-choice.active {
        background: color-mix(in srgb, var(--primary-color) 18%, transparent);
        color: var(--primary-color);
        border-color: color-mix(in srgb, var(--primary-color) 45%, var(--card-border));
    }

    .mini-choice:hover:not(.active) {
        background: color-mix(in srgb, var(--button-hover-surface) 86%, transparent);
        color: var(--text-color);
        border-color: color-mix(in srgb, var(--primary-color) 24%, var(--button-hover-border));
    }

    .picker-dropdown {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        text-align: left;
    }

    .fixed-bottom {
        position: fixed;
        bottom: var(--page-action-offset);
        left: var(--desktop-nav-clearance);
        right: 0;
        padding: 0 1.5rem;
        display: flex;
        justify-content: center;
        pointer-events: none;
        z-index: 5;
    }

    .primary-btn {
        width: 100%;
        max-width: 400px;
        background: var(--primary-color);
        border-color: transparent;
        padding: 1rem;
        font-size: var(--font-size-card-title);
        border-radius: 18px;
        opacity: 1;
        transition: opacity 0.2s;
        pointer-events: auto;
        color: var(--primary-contrast);
    }

    .primary-btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
        z-index: 1000;
    }

    .count-modal {
        width: 100%;
        max-width: 360px;
        padding: 1.2rem;
        border-radius: 22px;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .count-modal-copy h3 {
        margin: 0;
        font-size: var(--font-size-card-title);
    }

    .count-modal-copy p {
        margin: 0.25rem 0 0;
    }

    .count-input {
        text-align: center;
        font-size: calc(var(--font-size-card-title) + 0.2rem);
        font-weight: 700;
    }

    .error-text {
        color: #ef4444;
        font-size: var(--font-size-body-xs);
        margin: 0;
    }

    .count-modal-actions {
        display: flex;
        gap: 0.75rem;
    }

    .modal-btn {
        flex: 1;
        padding: 0.9rem 1rem;
        border-radius: 14px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    .modal-primary {
        background: var(--primary-color);
        color: var(--primary-contrast);
        border-color: transparent;
    }

    @@media (max-width: 720px) {
        .view-container {
            padding-top: 1.5rem;
        }

        .app-header {
            padding: 1.5rem 1rem 1rem;
            gap: 0.5rem;
        }

        .header-title {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
            padding: 0 0.5rem;
        }

        .content-scroll {
            padding: 0 1rem;
            padding-bottom: calc(var(--page-action-clearance) + 1rem);
        }

        .fixed-bottom {
            left: 0;
            padding: 0 1rem;
        }

        .form-row {
            flex-direction: column;
        }

        .picker-group {
            width: 100%;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .stepper-row {
            gap: 0.55rem;
            flex-wrap: wrap;
        }

        .stepper-btn,
        .picker-btn {
            width: 58px;
            height: 58px;
        }

        .mini-choice {
            flex: 1;
            min-width: 0;
        }
    }

    @@media (max-width: 540px) {
        .stepper-display,
        .picker-dropdown {
            min-height: 52px;
        }

        .segmented-control {
            flex-direction: column;
        }
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Title { get; set; }

    [SupplyParameterFromQuery]
    public string? Desc { get; set; }

    [SupplyParameterFromQuery]
    public string? Icon { get; set; }

    [SupplyParameterFromQuery]
    public string? Color { get; set; }

    [SupplyParameterFromQuery(Name = "editId")]
    public string? EditId { get; set; }

    [SupplyParameterFromQuery(Name = "reset")]
    public string? ResetToken { get; set; }

    private readonly string[] frequencyOptions = ["Daily", "Weekly", "Monthly"];
    private Habit habit = new();
    private bool isEditing;
    private string? loadedEditId;
    private bool isIconPickerOpen;
    private bool isCountEditorOpen;
    private string editCountText = "1";
    private string countEditorError = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        isEditing = !string.IsNullOrWhiteSpace(EditId);

        if (isEditing)
        {
            if (loadedEditId != EditId)
            {
                var existingHabit = await DbService.GetHabitByIdAsync(EditId!);

                if (existingHabit == null)
                {
                    NavManager.NavigateTo("/app");
                    return;
                }

                DraftService.LoadFromHabit(existingHabit);
                loadedEditId = EditId;
            }
        }
        else
        {
            DraftService.Initialize(Title, Desc, Icon, Color, ShouldReset());
            loadedEditId = null;
        }

        habit = DraftService.Draft;
    }

    private bool ShouldReset()
    {
        return !string.IsNullOrWhiteSpace(ResetToken)
            && (ResetToken.Equals("true", StringComparison.OrdinalIgnoreCase)
                || ResetToken == "1");
    }

    private void IncrementCount()
    {
        habit.TargetCount++;
    }

    private void DecrementCount()
    {
        if (habit.TargetCount > 1)
        {
            habit.TargetCount--;
        }
    }

    private void OpenCountEditor()
    {
        editCountText = habit.TargetCount.ToString();
        countEditorError = string.Empty;
        isCountEditorOpen = true;
    }

    private void CloseCountEditor()
    {
        isCountEditorOpen = false;
        countEditorError = string.Empty;
    }

    private void SaveEditedCount()
    {
        if (!int.TryParse(editCountText, out var parsedCount) || parsedCount < 1)
        {
            countEditorError = "Enter a number greater than 0.";
            return;
        }

        habit.TargetCount = parsedCount;
        CloseCountEditor();
    }

    private void SetTrackingMode(string mode)
    {
        habit.TrackingMode = mode;
    }

    private string IsTrackingMode(string mode)
    {
        return habit.TrackingMode == mode ? "active" : string.Empty;
    }

    private void SetFrequency(string frequency)
    {
        habit.Frequency = frequency;
    }

    private string IsFrequency(string frequency)
    {
        return habit.Frequency == frequency ? "active" : string.Empty;
    }

    private string GetFrequencySummary()
    {
        return habit.Frequency switch
        {
            "Weekly" => $"Weekly - {GetWeeklySummary()}",
            "Monthly" => $"Monthly - {GetMonthlySummary()}",
            _ => "Daily"
        };
    }

    private string GetWeeklySummary()
    {
        return string.Join(", ", GetWeeklySelections());
    }

    private string GetMonthlySummary()
    {
        return string.Join(", ", GetMonthlySelections().Select(day => $"Day {day}"));
    }

    private List<string> GetWeeklySelections()
    {
        var selections = habit.WeeklyDaysCsv
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct()
            .ToList();

        if (selections.Count == 0)
        {
            selections.Add(string.IsNullOrWhiteSpace(habit.WeeklyDay) ? "Mon" : habit.WeeklyDay);
        }

        return selections;
    }

    private List<int> GetMonthlySelections()
    {
        var selections = habit.MonthlyDaysCsv
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(value => int.TryParse(value, out var parsed) ? parsed : -1)
            .Where(value => value >= 1 && value <= 31)
            .Distinct()
            .OrderBy(value => value)
            .ToList();

        if (selections.Count == 0)
        {
            selections.Add(Math.Clamp(habit.MonthlyDay, 1, 31));
        }

        return selections;
    }

    private void OpenIconPicker() => isIconPickerOpen = true;
    private void CloseIconPicker() => isIconPickerOpen = false;

    private void SelectIcon(string icon)
    {
        habit.Icon = icon;
        isIconPickerOpen = false;
    }

    private void SelectColor(string color)
    {
        habit.Color = color;
    }

    private async Task SaveHabit()
    {
        if (string.IsNullOrWhiteSpace(habit.Title))
        {
            return;
        }

        await DbService.SaveHabitAsync(habit);
        var habitId = habit.Id;
        DraftService.Reset();
        NavManager.NavigateTo(isEditing ? $"/habit/{habitId}" : "/app");
    }

    private void NavigateBack()
    {
        NavManager.NavigateTo(isEditing ? $"/habit/{EditId}" : "/add-habit");
    }
}
