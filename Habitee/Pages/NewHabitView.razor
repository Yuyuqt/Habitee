@page "/new-habit"
@using Habitee.Models
@using Habitee.Services
@inject NavigationManager NavManager
@inject DatabaseService DbService

<div class="view-container slide-in">
    <header class="app-header">
        <button class="icon-btn" @onclick='() => NavManager.NavigateTo("/add-habit")'>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <h1 class="header-title">New Habit</h1>
        <div style="width: 24px;"></div>
    </header>

    <div class="form-container content-scroll">
        <div class="form-row" style="align-items: flex-start;">
            <div class="input-group" style="flex: 1;">
                <label>NAME</label>
                <input type="text" class="glass-input" @bind="habit.Title" @bind:event="oninput" />
            </div>
            
            <div class="picker-group">
                <div class="input-group">
                    <label>ICON</label>
                    <button class="picker-btn glass-panel" style="color: @habit.Color;" @onclick="OpenIconPicker">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <path d="M12 8v8"></path>
                            <path d="M8 12h8"></path>
                        </svg>
                    </button>
                </div>
                <div class="input-group">
                    <label>COLOR</label>
                    <button class="picker-btn glass-panel" style="background-color: @habit.Color;" @onclick="OpenColorPicker"></button>
                </div>
            </div>
        </div>

        <div class="input-group">
            <label>DESCRIPTION</label>
            <input type="text" class="glass-input" placeholder="Optional" @bind="habit.Description" />
        </div>

        <div class="input-group">
            <label>COMPLETIONS PER DAY</label>
            <div class="stepper-row">
                <div class="glass-input stepper-display">
                    @habit.TargetCount / Day
                </div>
                <button class="stepper-btn glass-panel">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </button>
                <button class="stepper-btn glass-panel" @onclick="IncrementCount">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </button>
            </div>
        </div>

        <div class="input-group">
            <label>HOW SHOULD COMPLETIONS BE TRACKED?</label>
            <div class="segmented-control glass-panel">
                <button class="segment active">Step by step</button>
                <button class="segment">Custom value</button>
            </div>
        </div>

        <div class="input-group">
            <label>FREQUENCY & REMINDERS</label>
            <button class="glass-input picker-dropdown">
                <span>Daily</span>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </button>
        </div>
        
        <div style="height: 100px;"></div>
    </div>

    <div class="fixed-bottom">
        <button class="primary-btn glass-button" disabled="@string.IsNullOrWhiteSpace(habit.Title)" @onclick="SaveHabit">
            Save
        </button>
    </div>
</div>

@if (isIconPickerOpen)
{
    <Habitee.Components.IconPickerModal SelectedIcon="@habit.Icon" OnIconSelected="SelectIcon" OnClose="CloseIconPicker" />
}

@if (isColorPickerOpen)
{
    <Habitee.Components.ColorPickerModal SelectedColor="@habit.Color" OnColorSelected="SelectColor" OnClose="CloseColorPicker" />
}

<style>
    .view-container {
        display: flex;
        flex-direction: column;
        height: 100vh;
        max-width: 800px;
        margin: 0 auto;
        position: relative;
    }

    .app-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
    }

    .header-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem;
    }

    .form-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .input-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .input-group label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 1px;
    }

    .glass-input {
        width: 100%;
        padding: 1rem;
        border-radius: 12px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        backdrop-filter: blur(10px);
        font-family: inherit;
        font-size: 1rem;
    }

    .form-row {
        display: flex;
        gap: 1rem;
    }

    .picker-group {
        display: flex;
        gap: 1rem;
    }

    .picker-btn {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        cursor: pointer;
        padding: 0;
    }

    .stepper-row {
        display: flex;
        gap: 0.5rem;
    }

    .stepper-display {
        flex: 1;
        display: flex;
        align-items: center;
    }

    .stepper-btn {
        width: 56px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        cursor: pointer;
        color: var(--text-color);
    }

    .segmented-control {
        display: flex;
        padding: 0.25rem;
        border-radius: 12px;
    }

    .segment {
        flex: 1;
        padding: 0.75rem;
        border: none;
        background: transparent;
        color: var(--text-muted);
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
    }

    .segment.active {
        background: #3b82f6; /* Hardcoded blue from screenshot */
        color: white;
    }

    .picker-dropdown {
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        text-align: left;
    }

    .fixed-bottom {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1.5rem;
        background: linear-gradient(to top, var(--bg-color) 60%, transparent);
        display: flex;
        justify-content: center;
    }

    .primary-btn {
        width: 100%;
        max-width: 400px;
        background: var(--card-border);
        color: var(--bg-color);
        border: none;
        padding: 1rem;
        font-size: 1.1rem;
        border-radius: 16px;
        opacity: 1;
        transition: opacity 0.2s;
    }

    .primary-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Title { get; set; }
    [SupplyParameterFromQuery]
    public string? Desc { get; set; }
    [SupplyParameterFromQuery]
    public string? Icon { get; set; }
    [SupplyParameterFromQuery]
    public string? Color { get; set; }

    private Habit habit = new Habit();

    private bool isIconPickerOpen = false;
    private bool isColorPickerOpen = false;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(Title)) habit.Title = Uri.UnescapeDataString(Title);
        if (!string.IsNullOrEmpty(Desc)) habit.Description = Uri.UnescapeDataString(Desc);
        if (!string.IsNullOrEmpty(Icon)) habit.Icon = Icon;
        if (!string.IsNullOrEmpty(Color)) habit.Color = Uri.UnescapeDataString(Color);
        else habit.Color = "#10b981"; // Default green
    }

    private void IncrementCount()
    {
        habit.TargetCount++;
    }

    private void OpenIconPicker() => isIconPickerOpen = true;
    private void CloseIconPicker() => isIconPickerOpen = false;
    private void SelectIcon(string icon)
    {
        habit.Icon = icon;
        isIconPickerOpen = false;
    }

    private void OpenColorPicker() => isColorPickerOpen = true;
    private void CloseColorPicker() => isColorPickerOpen = false;
    private void SelectColor(string color)
    {
        habit.Color = color;
        isColorPickerOpen = false;
    }

    private async Task SaveHabit()
    {
        if (string.IsNullOrWhiteSpace(habit.Title)) return;
        
        await DbService.SaveHabitAsync(habit);
        NavManager.NavigateTo("/");
    }
}
