<div class="habit-icon-wrapper">
    <svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" 
         stroke="@Color" 
         stroke-width="2" 
         stroke-linecap="round" stroke-linejoin="round">
        @((MarkupString)GetIconPath(Name))
    </svg>
</div>

<style>
    .habit-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>

@code {
    [Parameter] public string Name { get; set; } = "check";
    [Parameter] public string Color { get; set; } = "var(--primary-color)";
    [Parameter] public int Size { get; set; } = 24;

    private string GetIconPath(string name) => HabitIconCatalog.GetSvgPath(name);
}
