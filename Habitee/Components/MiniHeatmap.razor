@using Habitee.Models

<div class="mini-heatmap">
    @for (int i = 4; i >= 0; i--)
    {
        var dateStr = DateTime.Today.AddDays(-i).ToString("yyyy-MM-dd");
        var isCompleted = Logs.Any(l => l.Date == dateStr && l.CompletedCount >= TargetCount);
        
        <div class="heatmap-cell @(isCompleted ? "completed" : "")" title="@dateStr"></div>
    }
</div>

<style>
    .mini-heatmap {
        display: flex;
        gap: 4px;
        align-items: center;
    }

    .heatmap-cell {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background-color: transparent;
        border: var(--outline-width, 1px) solid var(--card-border);
        transition: background-color 0.3s ease;
    }

    .heatmap-cell.completed {
        background-color: var(--success-color);
        box-shadow: 0 0 4px var(--success-color);
        border-color: var(--card-border);
    }
</style>

@code {
    [Parameter]
    public List<HabitLog> Logs { get; set; } = new();

    [Parameter]
    public int TargetCount { get; set; } = 1;
}
