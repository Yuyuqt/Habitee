@using Microsoft.AspNetCore.Components

<div class="modal-overlay slide-up">
    <div class="modal-content">
        <header class="modal-header">
            <button class="icon-btn" @onclick="OnClose">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <h2 class="modal-title">Pick Icon</h2>
            <button class="icon-btn" @onclick="OnClose">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
        </header>

        <div class="modal-body content-scroll">
            <div class="search-shell">
                <input type="text"
                       class="search-input glass-panel"
                       placeholder="Search icons"
                       @bind="searchQuery"
                       @bind:event="oninput" />
            </div>

            @if (VisibleIconGroups.Any())
            {
                @foreach (var group in VisibleIconGroups)
                {
                    <div class="icon-section">
                        <h3 class="section-title">@group.Key.ToUpperInvariant()</h3>
                        <div class="icon-grid">
                            @foreach (var icon in group)
                            {
                                <button class="icon-swatch glass-panel @(SelectedIcon == icon.Key ? "selected" : "")"
                                        @onclick="() => SelectIcon(icon.Key)"
                                        title="@icon.Label"
                                        aria-label="@icon.Label">
                                    <HabitIcon Name="@icon.Key" Color="currentColor" Size="24" />
                                    <span class="icon-label">@icon.Label</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="empty-state glass-panel">
                    <h3>No icons found</h3>
                    <p>Try a different word like health, work, travel, or focus.</p>
                </div>
            }

            <div style="height: 50px;"></div>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: var(--bg-color);
        z-index: 1000;
        display: flex;
        justify-content: center;
    }

    .slide-up {
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }

    .modal-content {
        width: 100%;
        max-width: 800px;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: var(--bg-gradient, var(--bg-color));
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
        gap: 1rem;
    }

    .modal-title {
        font-size: var(--font-size-section-title);
        font-weight: 700;
        margin: 0;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem;
    }

    .search-shell {
        position: sticky;
        top: 0;
        z-index: 2;
        padding: 0.25rem 0 1rem;
        background: linear-gradient(to bottom, var(--bg-color) 78%, transparent);
    }

    .search-input {
        width: 100%;
        padding: 0.95rem 1rem;
        border-radius: 16px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        color: var(--text-color);
        font-family: inherit;
        font-size: var(--font-size-body);
    }

    .search-input::placeholder {
        color: var(--text-muted);
    }

    .icon-section {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: var(--font-size-label);
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 1px;
        margin-bottom: 0.75rem;
        text-transform: uppercase;
    }

    .icon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
        gap: 0.75rem;
    }

    .icon-swatch {
        min-height: 88px;
        padding: 0.85rem 0.5rem 0.65rem;
        border-radius: 16px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        cursor: pointer;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.55rem;
        transition: transform 0.2s, border-color 0.2s, background-color 0.2s, color 0.2s;
        color: var(--text-color);
        text-align: center;
    }

    .icon-swatch:active {
        transform: scale(0.95);
    }

    .icon-swatch.selected {
        border-color: var(--primary-color);
        color: var(--primary-color);
        background: color-mix(in srgb, var(--primary-color) 12%, var(--card-bg));
    }

    .icon-label {
        font-size: var(--font-size-micro);
        line-height: 1.15;
    }

    .empty-state {
        padding: 1.25rem;
        border-radius: 20px;
        border: var(--outline-width, 1px) solid var(--card-border);
        background: var(--card-bg);
        text-align: center;
        color: var(--text-muted);
    }

    .empty-state h3 {
        margin: 0 0 0.35rem;
        color: var(--text-color);
        font-size: var(--font-size-body);
    }

    .empty-state p {
        margin: 0;
        font-size: var(--font-size-body-sm);
    }

    @@media (max-width: 480px) {
        .content-scroll {
            padding: 0 1rem;
        }

        .icon-grid {
            grid-template-columns: repeat(auto-fill, minmax(76px, 1fr));
        }

        .icon-swatch {
            min-height: 80px;
            padding: 0.75rem 0.45rem 0.6rem;
        }
    }
</style>

@code {
    [Parameter]
    public string SelectedIcon { get; set; } = "check";

    [Parameter]
    public EventCallback<string> OnIconSelected { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private string searchQuery = string.Empty;

    private List<IGrouping<string, HabitIconDefinition>> VisibleIconGroups => HabitIconCatalog.All
        .Where(IsVisible)
        .GroupBy(icon => icon.Category)
        .ToList();

    private async Task SelectIcon(string icon)
    {
        SelectedIcon = icon;
        await OnIconSelected.InvokeAsync(icon);
    }

    private bool IsVisible(HabitIconDefinition icon)
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return true;
        }

        return icon.Label.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
            || icon.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase);
    }
}
