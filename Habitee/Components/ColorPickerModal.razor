@using Microsoft.AspNetCore.Components

<div class="modal-overlay slide-up">
    <div class="modal-content">
        <header class="modal-header">
            <button class="icon-btn" @onclick="OnClose">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <h2 class="modal-title">Pick Color</h2>
            <button class="icon-btn" @onclick="OnClose">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </button>
        </header>

        <div class="modal-body content-scroll">
            <div class="color-section">
                <h3 class="section-title">PICK A COLOR</h3>
                <div class="color-grid glass-panel">
                    @foreach (var color in colors)
                    {
                        <button class="color-swatch @(SelectedColor == color ? "selected" : "")" 
                                style="background-color: @color;"
                                @onclick="() => SelectColor(color)">
                        </button>
                    }
                </div>
            </div>
            <div style="height: 50px;"></div>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: var(--bg-color);
        z-index: 1000;
        display: flex;
        justify-content: center;
    }

    .slide-up {
        animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes slideUp {
        from { transform: translateY(100%); }
        to { transform: translateY(0); }
    }

    .modal-content {
        width: 100%;
        max-width: 800px;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: var(--bg-gradient, var(--bg-color));
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem;
    }

    .modal-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0;
    }

    .icon-btn {
        background: none;
        border: none;
        color: var(--text-color);
        cursor: pointer;
        padding: 0.5rem;
        display: flex;
    }

    .content-scroll {
        flex: 1;
        overflow-y: auto;
        padding: 0 1.5rem;
    }

    .section-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-muted);
        letter-spacing: 1px;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
    }

    .color-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(48px, 1fr));
        gap: 0.75rem;
        padding: 1rem;
    }

    .color-swatch {
        aspect-ratio: 1;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: transform 0.2s;
        position: relative;
    }
    
    .color-swatch:active {
        transform: scale(0.9);
    }

    .color-swatch.selected::after {
        content: '';
        position: absolute;
        top: -4px;
        left: -4px;
        right: -4px;
        bottom: -4px;
        border: 3px solid var(--text-color);
        border-radius: 12px;
        pointer-events: none;
    }
</style>

@code {
    [Parameter]
    public string SelectedColor { get; set; } = "";

    [Parameter]
    public EventCallback<string> OnColorSelected { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task SelectColor(string color)
    {
        SelectedColor = color;
        await OnColorSelected.InvokeAsync(color);
    }

    private string[] colors = new[]
    {
        "#f43f5e", "#f97316", "#10b981", "#6366f1", "#3b82f6", "#d946ef", "#475569",
        "#fb7185", "#fbbf24", "#34d399", "#8b5cf6", "#38bdf8", "#e879f9", "#64748b",
        "#fda4af", "#fde047", "#86efac", "#a78bfa", "#7dd3fc", "#f472b6", "#94a3b8"
    };
}
