@using Habitee.Models
@using Habitee.Services

<div class="monthly-graph @(Compact ? "compact" : "")">
    @foreach (var month in monthsToDisplay)
    {
        <div class="month-block">
            @if (ShowMonthLabel)
            {
                <h4 class="month-title">@month.ToString("MMMM")</h4>
            }
            <div class="weekdays">
                <span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
            </div>
            <div class="days-grid">
                @{
                    var firstDayOfMonth = new DateTime(month.Year, month.Month, 1);
                    var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
                    
                    // 1 = Monday, 7 = Sunday
                    var startDayOfWeek = (int)firstDayOfMonth.DayOfWeek;
                    if (startDayOfWeek == 0) startDayOfWeek = 7; // Sunday is 0, make it 7
                    
                    // Empty cells for alignment
                    for (int i = 1; i < startDayOfWeek; i++)
                    {
                        <div class="day-cell empty"></div>
                    }

                    for (int day = 1; day <= daysInMonth; day++)
                    {
                        var currentDate = new DateTime(month.Year, month.Month, day);
                        var isFuture = currentDate > DateTime.Today;
                        var dateStr = currentDate.ToString("yyyy-MM-dd");
                        var isCompleted = Logs.Any(l => l.Date == dateStr && DatabaseService.IsCompleteForTarget(l.CompletedCount, TargetCount));
                        
                        <div class="day-cell @(isFuture ? "future" : "") @(isCompleted ? "completed" : "")" 
                             style="@(isCompleted ? $"background-color: {Color}; opacity: 0.8;" : "")"
                             title="@dateStr">
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

<style>
    .monthly-graph {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        padding-bottom: 0.5rem;
        scrollbar-width: thin;
        width: 100%;
        mask-image: linear-gradient(to right, black 80%, transparent 100%);
        -webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%);
    }

    .month-block {
        display: flex;
        flex-direction: column;
        min-width: 120px;
    }

    .monthly-graph.compact {
        gap: 0;
        overflow-x: visible;
        padding-bottom: 0;
        mask-image: none;
        -webkit-mask-image: none;
    }

    .monthly-graph.compact .month-block {
        min-width: 100%;
    }

    .month-title {
        font-size: var(--font-size-badge);
        color: var(--text-muted);
        margin: 0 0 0.25rem 0;
        font-weight: 500;
        text-align: center;
    }

    .weekdays {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
        margin-bottom: 2px;
    }

    .weekdays span {
        font-size: var(--font-size-micro);
        color: var(--text-muted);
        text-align: center;
        opacity: 0.6;
    }

    .days-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 2px;
    }

    .day-cell {
        aspect-ratio: 1;
        border-radius: 6px;
        background-color: color-mix(in srgb, var(--text-color) 10%, var(--card-bg));
        transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.15s ease;
    }

    .day-cell:hover:not(.empty) {
        transform: scale(1.3);
        z-index: 10;
    }

    .day-cell.empty {
        background-color: transparent;
        opacity: 0;
    }

    .day-cell.future {
        background-color: color-mix(in srgb, var(--text-color) 4%, var(--card-bg));
        border: 1px dashed var(--card-border);
        opacity: 0.4;
    }

    .day-cell.completed {
        /* Background color is set inline to support custom colors */
        border: none;
        box-shadow: none;
    }

    .monthly-graph.compact .weekdays {
        gap: 2px;
        margin-bottom: 3px;
    }

    .monthly-graph.compact .weekdays span {
        font-size: 0.5rem;
        font-weight: 600;
        opacity: 0.7;
    }

    .monthly-graph.compact .days-grid {
        gap: 2px;
    }

    .monthly-graph.compact .day-cell {
        min-height: 10px;
        border-radius: 5px;
        opacity: 0.62;
    }

    .monthly-graph.compact .day-cell.future {
        border-style: solid;
        opacity: 0.4;
    }

    .monthly-graph.compact .day-cell.completed {
        opacity: 1;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
    }

    [data-theme-mode="dark"] .day-cell {
        background-color: color-mix(in srgb, var(--text-color) 16%, var(--card-bg));
    }

    [data-theme-mode="dark"] .day-cell.future {
        background-color: color-mix(in srgb, var(--text-color) 7%, var(--card-bg));
        opacity: 0.5;
    }

    [data-theme-mode="dark"] .monthly-graph.compact .day-cell {
        opacity: 0.78;
    }

    [data-theme-mode="dark"] .monthly-graph.compact .day-cell.future {
        opacity: 0.48;
    }
</style>

@code {
    [Parameter]
    public List<HabitLog> Logs { get; set; } = new();

    [Parameter]
    public int TargetCount { get; set; } = 1;

    [Parameter]
    public string Color { get; set; } = "var(--primary-color)";

    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public int MonthsToShow { get; set; } = 4;

    [Parameter]
    public bool ShowMonthLabel { get; set; } = true;

    private List<DateTime> monthsToDisplay = new();

    protected override void OnParametersSet()
    {
        var today = DateTime.Today;
        var safeMonthsToShow = Math.Max(1, MonthsToShow);

        monthsToDisplay = Enumerable.Range(0, safeMonthsToShow)
            .Select(offset => new DateTime(today.Year, today.Month, 1).AddMonths(offset - (safeMonthsToShow - 1)))
            .ToList();

        if (Compact && MonthsToShow == 4)
        {
            monthsToDisplay = new List<DateTime>
            {
                new DateTime(today.Year, today.Month, 1)
            };
        }
    }
}
