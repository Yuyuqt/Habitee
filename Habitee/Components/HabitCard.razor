@using Habitee.Models
@using Habitee.Services
@inject ThemeService ThemeService
@inject ConfettiService ConfettiService
@inject NavigationManager NavManager

<div class="habit-card glass-panel card-hover-lift @(ThemeService.CurrentTheme == "pastel" ? "pastel-card" : "")" @onclick="GoToDetail">
    <div class="habit-header">
        <div class="habit-icon-wrapper" style="background-color: @(Habit.Color)20; border: @(ThemeService.CurrentTheme == "pastel" ? "2px solid var(--card-border)" : "1px solid " + Habit.Color);">
            <div class="@(isPopping ? "animate-pop" : "")" style="display: flex;">
                @RenderIcon(Habit.Icon)
            </div>
        </div>
        
        <div class="habit-details">
            <h3 class="habit-title">@Habit.Title</h3>
            @if (!string.IsNullOrEmpty(Habit.Description))
            {
                <p class="habit-desc">@Habit.Description</p>
            }
        </div>

        <div class="habit-status">
            <span class="habit-streak">
                @(TodayLog?.CompletedCount ?? 0) of @Habit.TargetCount
            </span>
            <button class="habit-action glass-button @(ThemeService.CurrentTheme == "pastel" ? "pastel-action" : "")" @onclick="CompleteHabit" @onclick:stopPropagation="true">
                @if ((TodayLog?.CompletedCount ?? 0) >= Habit.TargetCount)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                }
                else if (Habit.TargetCount > 1)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"></line><line x1="5" x2="19" y1="12" y2="12"></line></svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                }
            </button>
        </div>
    </div>
    
    <div class="habit-graph-container">
        <MonthlyContributionGraph Logs="Logs" TargetCount="Habit.TargetCount" Color="@Habit.Color" />
    </div>
</div>

<style>
    .habit-card {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        gap: 1rem;
        margin-bottom: 1rem;
        cursor: pointer;
    }

    .habit-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
    }

    .pastel-card {
        border-width: 2px !important;
    }

    .habit-icon-wrapper {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .habit-details {
        flex: 1;
        min-width: 0;
    }

    .habit-title {
        font-size: 1.1rem;
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .habit-desc {
        font-size: 0.85rem;
        margin: 0.25rem 0 0.5rem 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .habit-meta {
        display: none; /* Removed but kept class just in case */
    }

    .habit-status {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0;
    }

    .habit-graph-container {
        width: 100%;
        margin-top: 0.5rem;
    }

    .habit-streak {
        font-size: 0.9rem;
        color: var(--text-color);
        font-family: var(--font-family);
        font-weight: 500;
    }

    .habit-action {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        flex-shrink: 0;
    }

    .pastel-action {
        border-width: 2px !important;
    }
</style>

@code {
    [Parameter]
    public Habit Habit { get; set; } = new();

    [Parameter]
    public List<HabitLog> Logs { get; set; } = new();

    [Parameter]
    public EventCallback<Habit> OnComplete { get; set; }

    [Parameter]
    public bool DisableNavigation { get; set; } = false;

    private bool isPopping = false;

    private HabitLog? TodayLog => Logs.FirstOrDefault(l => l.Date == DateTime.Today.ToString("yyyy-MM-dd"));

    private void GoToDetail()
    {
        if (!DisableNavigation)
        {
            NavManager.NavigateTo($"/habit/{Habit.Id}");
        }
    }

    private async Task CompleteHabit()
    {
        isPopping = false;
        await Task.Delay(10); // reset animation
        isPopping = true;
        
        await OnComplete.InvokeAsync(Habit);

        // Check if goal met
        if (TodayLog != null && TodayLog.CompletedCount >= Habit.TargetCount)
        {
            ConfettiService.TriggerBurst();
        }
    }

    private RenderFragment RenderIcon(string name) => builder =>
    {
        string svgPath = name switch
        {
            "target" => "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><circle cx=\"12\" cy=\"12\" r=\"6\"></circle><circle cx=\"12\" cy=\"12\" r=\"2\"></circle>",
            "water" => "<path d=\"M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z\"></path>",
            "book" => "<path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20\"></path><path d=\"M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z\"></path>",
            "pill" => "<path d=\"M14 2H6a2 2 0 0 0-2 2v16c0 1.1.9 2 2 2h12a2 2 0 0 0 2-2V8l-6-6z\"></path><path d=\"M14 3v5h5M16 13H8M16 17H8\"></path>",
            "code" => "<polyline points=\"16 18 22 12 16 6\"></polyline><polyline points=\"8 6 2 12 8 18\"></polyline>",
            "heart" => "<path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"></path>",
            "dumbbell" => "<path d=\"M14.4 14.4l5.6-5.6\"></path><path d=\"M20 12l2 2\"></path><path d=\"M2 10l2 2\"></path><path d=\"M9.6 9.6l-5.6 5.6\"></path><path d=\"M14 2l8 8\"></path><path d=\"M2 14l8 8\"></path>",
            "bike" => "<circle cx=\"5.5\" cy=\"17.5\" r=\"3.5\"></circle><circle cx=\"18.5\" cy=\"17.5\" r=\"3.5\"></circle><path d=\"M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5V14l-3-3 4-3 2 3h2\"></path>",
            "run" => "<path d=\"M13 4v4l-4 2\"></path><path d=\"M13 14l4-4\"></path><path d=\"M13 18l-3-4\"></path><path d=\"M16 22l-3-4\"></path>",
            "cutlery" => "<path d=\"M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2\"></path><path d=\"M7 2v20\"></path><path d=\"M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3zm0 0v7\"></path>",
            "burger" => "<path d=\"M3 11h18\"></path><path d=\"M4 11a8 8 0 0 1 16 0\"></path><path d=\"M4 17a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4\"></path><path d=\"M3 14h18\"></path>",
            "soda" => "<path d=\"M6 5h12\"></path><path d=\"M8 5v14a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V5\"></path><path d=\"M9 2l3 3 3-3\"></path>",
            "sugar" => "<path d=\"M12 2v20\"></path><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"></path>",
            "meditate" => "<circle cx=\"12\" cy=\"6\" r=\"2\"></circle><path d=\"M12 10v4\"></path><path d=\"M8 14h8\"></path><path d=\"M5 18l3-4\"></path><path d=\"M19 18l-3-4\"></path>",
            "tooth" => "<path d=\"M12 21a3 3 0 0 1-3-3V6a3 3 0 0 1 6 0v12a3 3 0 0 1-3 3z\"></path><path d=\"M15 15H9\"></path>",
            _ => "<circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 8v8\"></path><path d=\"M8 12h8\"></path>" // check/plus fallback
        };

        var color = ThemeService.CurrentTheme == "pastel" ? "#705246" : Habit.Color;
        var strokeWidth = ThemeService.CurrentTheme == "pastel" ? "2.5" : "2";

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "width", "24");
        builder.AddAttribute(2, "height", "24");
        builder.AddAttribute(3, "viewBox", "0 0 24 24");
        builder.AddAttribute(4, "fill", "none");
        builder.AddAttribute(5, "stroke", color);
        builder.AddAttribute(6, "stroke-width", strokeWidth);
        builder.AddAttribute(7, "stroke-linecap", "round");
        builder.AddAttribute(8, "stroke-linejoin", "round");
        builder.AddMarkupContent(9, svgPath);
        builder.CloseElement();
    };
}
