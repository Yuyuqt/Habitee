@using Habitee.Models
@using Habitee.Services
@inject NavigationManager NavManager

<div class="habit-card glass-panel card-hover-lift" @onclick="GoToDetail">
    <div class="habit-header">
        <div class="habit-icon-shell" style="@($"--habit-color: {Habit.Color};")">
            <HabitIcon Name="@Habit.Icon" Color="@Habit.Color" Size="28" />
        </div>
        
        <div class="habit-details">
            <h3 class="habit-title">@Habit.Title</h3>
            @if (!string.IsNullOrEmpty(Habit.Description))
            {
                <p class="habit-desc">@Habit.Description</p>
            }
        </div>

        <div class="habit-status">
            <span class="habit-streak">
                @CurrentCount of @Habit.TargetCount
            </span>
            <button class="habit-action glass-button" @onclick="CompleteHabit" @onclick:stopPropagation="true">
                @if (IsCompletedToday)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--success-color)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                }
                else if (Habit.TargetCount > 1)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"></line><line x1="5" x2="19" y1="12" y2="12"></line></svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                }
            </button>
        </div>
    </div>
    
    <div class="habit-graph-container">
        <MonthlyContributionGraph Logs="Logs" TargetCount="Habit.TargetCount" Color="@Habit.Color" MonthsToShow="@MonthsToShow" />
    </div>
</div>

<style>
    .habit-card {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        gap: 1rem;
        margin-bottom: 1rem;
        cursor: pointer;
    }

    .habit-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        width: 100%;
    }

    .habit-icon-shell {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        border: 2px solid color-mix(in srgb, var(--habit-color) 45%, var(--card-border));
        background: color-mix(in srgb, var(--habit-color) 10%, transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .habit-details {
        flex: 1;
        min-width: 0;
    }

    .habit-title {
        font-size: var(--font-size-card-title);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .habit-desc {
        font-size: var(--font-size-body-xs);
        margin: 0.25rem 0 0.5rem 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .habit-meta {
        display: none; /* Removed but kept class just in case */
    }

    .habit-status {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0;
    }

    .habit-graph-container {
        width: 100%;
        margin-top: 0.5rem;
    }

    .habit-streak {
        font-size: var(--font-size-body-sm);
        color: var(--text-color);
        font-family: var(--font-family);
        font-weight: 500;
    }

    .habit-action {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        flex-shrink: 0;
        transition: background-color 0.18s ease, color 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }

    .habit-action:hover {
        background: color-mix(in srgb, var(--button-hover-surface) 86%, transparent);
        border-color: color-mix(in srgb, var(--habit-color) 52%, var(--button-hover-border));
        color: var(--text-color);
    }

</style>

@code {
    [Parameter]
    public Habit Habit { get; set; } = new();

    [Parameter]
    public List<HabitLog> Logs { get; set; } = new();

    [Parameter]
    public EventCallback<Habit> OnComplete { get; set; }

    [Parameter]
    public bool DisableNavigation { get; set; } = false;

    [Parameter]
    public int MonthsToShow { get; set; } = 4;

    private HabitLog? TodayLog => Logs.FirstOrDefault(l => l.Date == DateTime.Today.ToString("yyyy-MM-dd"));
    private int CurrentCount => DatabaseService.NormalizeCompletedCount(TodayLog?.CompletedCount ?? 0, Habit.TargetCount);
    private bool IsCompletedToday => DatabaseService.IsCompleteForTarget(TodayLog?.CompletedCount ?? 0, Habit.TargetCount);

    private void GoToDetail()
    {
        if (!DisableNavigation)
        {
            NavManager.NavigateTo($"/habit/{Habit.Id}");
        }
    }

    private async Task CompleteHabit()
    {
        await OnComplete.InvokeAsync(Habit);
    }
}
