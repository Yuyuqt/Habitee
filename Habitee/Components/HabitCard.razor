@using Habitee.Models
@using Habitee.Services
@inject NavigationManager NavManager

<div class="habit-card glass-panel card-hover-lift" @onclick="GoToDetail">
    <div class="habit-header">
        <div class="habit-icon-shell" style="@($"--habit-color: {Habit.Color};")">
            <HabitIcon Name="@Habit.Icon" Color="@Habit.Color" Size="28" />
        </div>
        
        <div class="habit-details">
            <h3 class="habit-title">@Habit.Title</h3>
            @if (!string.IsNullOrEmpty(Habit.Description))
            {
                <p class="habit-desc">@Habit.Description</p>
            }
        </div>

        <div class="habit-status">
            <span class="habit-streak">
                @CurrentCount of @Habit.TargetCount
            </span>
            <button class="habit-action glass-button @(IsCompletedToday ? "complete" : "pending")"
                    style="@($"--habit-color: {Habit.Color};")"
                    @onclick="CompleteHabit"
                    @onclick:stopPropagation="true">
                @if (IsCompletedToday)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                }
                else if (Habit.TargetCount > 1)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="5" y2="19"></line><line x1="5" x2="19" y1="12" y2="12"></line></svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                }
            </button>
        </div>
    </div>
    
    <div class="habit-graph-container">
        <MonthlyContributionGraph Logs="Logs" TargetCount="Habit.TargetCount" Color="@Habit.Color" MonthsToShow="@MonthsToShow" />
    </div>
</div>

<style>
    .habit-card {
        display: flex;
        flex-direction: column;
        padding: 1.25rem;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
        cursor: pointer;
    }

    .habit-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 1.25rem;
        width: 100%;
    }

    .habit-icon-shell {
        width: 58px;
        height: 58px;
        border-radius: 20px;
        border: 2px solid color-mix(in srgb, var(--habit-color) 35%, var(--card-border));
        background: color-mix(in srgb, var(--habit-color) 12%, transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    
    .habit-card:hover .habit-icon-shell {
        transform: scale(1.1) rotate(-3deg);
    }

    .habit-details {
        flex: 1;
        min-width: 0;
    }

    .habit-title {
        font-size: var(--font-size-card-title);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .habit-desc {
        font-size: var(--font-size-body-xs);
        margin: 0.25rem 0 0.5rem 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .habit-meta {
        display: none; /* Removed but kept class just in case */
    }

    .habit-status {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0;
    }

    .habit-graph-container {
        width: 100%;
        margin-top: 0.5rem;
    }

    .habit-streak {
        font-size: var(--font-size-body-sm);
        color: var(--text-color);
        font-family: var(--font-family);
        font-weight: 500;
    }

    .habit-action {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        flex-shrink: 0;
        transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .habit-action:hover {
        background: color-mix(in srgb, var(--habit-color) 15%, var(--button-hover-surface));
        border-color: var(--habit-color);
        color: var(--habit-color);
        transform: scale(1.1);
    }

    .habit-action.complete {
        background: color-mix(in srgb, var(--habit-color) 84%, white 16%);
        color: var(--primary-contrast);
        border-color: transparent;
    }

    .habit-action.complete:hover {
        background: color-mix(in srgb, var(--habit-color) 84%, white 16%);
        color: var(--primary-contrast);
        border-color: transparent;
        transform: scale(1.05);
    }
    
    .habit-action:active {
        transform: scale(0.9);
    }

    @("@media") (max-width: 720px) {
        .habit-card {
            padding: 1rem;
            gap: 1rem;
        }

        .habit-header {
            gap: 1rem;
        }

        .habit-title,
        .habit-desc {
            white-space: normal;
            overflow: visible;
            text-overflow: unset;
        }
    }

    @("@media") (max-width: 540px) {
        .habit-icon-shell {
            width: 52px;
            height: 52px;
            border-radius: 18px;
        }
    }

</style>

@code {
    [Parameter]
    public Habit Habit { get; set; } = new();

    [Parameter]
    public List<HabitLog> Logs { get; set; } = new();

    [Parameter]
    public EventCallback<Habit> OnComplete { get; set; }

    [Parameter]
    public bool DisableNavigation { get; set; } = false;

    [Parameter]
    public int MonthsToShow { get; set; } = 4;

    private HabitLog? TodayLog => Logs.FirstOrDefault(l => l.Date == DateTime.Today.ToString("yyyy-MM-dd"));
    private int CurrentCount => DatabaseService.NormalizeCompletedCount(TodayLog?.CompletedCount ?? 0, Habit.TargetCount);
    private bool IsCompletedToday => DatabaseService.IsCompleteForTarget(TodayLog?.CompletedCount ?? 0, Habit.TargetCount);

    private void GoToDetail()
    {
        if (!DisableNavigation)
        {
            NavManager.NavigateTo($"/habit/{Habit.Id}");
        }
    }

    private async Task CompleteHabit()
    {
        await OnComplete.InvokeAsync(Habit);
    }
}


